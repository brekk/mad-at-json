import type { Maybe } from "Maybe"

import type { Version } from "@/Version"

import { EQ, GT, LT } from "Compare"
import { Just, Nothing } from "Maybe"

import Study from "Study"

import { AnyVersion, FromVersion, UntilVersion, Version, VersionRange } from "@/Version"
import VV from "@/Version"



Study.report(
  Study.caseN2(compare),
  "compare   - LT",
  [
    #[#[Version(0, 9, 0), Version(1, 0, 0)], LT],
    #[#[Version(1, 0, 0), Version(1, 0, 0)], EQ],
    #[#[Version(1, 0, 0), Version(0, 7, 2)], GT],
  ],
)
scanReport = Study.report(scan)
scanReport("scan - good", [#["2.0.0", Just(Version(2, 0, 0))]])
scanReport("scan - missing last number", [#["2.0", (Nothing :: Maybe Version)]])
Study.report(
  VV.withinRange(VersionRange(Version(2, 0, 0), Version(2, 1, 0))),
  "withinRange - VersionRange true",
  [#[Version(2, 0, 0), true]],
)
Study.report(
  VV.withinRange(VersionRange(Version(1, 0, 0), Version(1, 9, 0))),
  "withinRange - VersionRange false",
  [#[Version(2, 0, 0), false]],
)
testwithinRange = Study.report(Study.caseN2(VV.withinRange))
testwithinRange(
  "withinRange - FromVersion true",
  [#[#[FromVersion(Version(1, 0, 0)), Version(2, 0, 0)], true]],
)
testwithinRange(
  "withinRange - FromVersion false",
  [#[#[FromVersion(Version(2, 0, 1)), Version(2, 0, 0)], false]],
)
testwithinRange(
  "withinRange - UntilVersion true",
  [#[#[UntilVersion(Version(2, 0, 1)), Version(2, 0, 0)], true]],
)
testwithinRange(
  "withinRange - UntilVersion false",
  [#[#[UntilVersion(Version(1, 3, 1)), Version(2, 0, 0)], false]],
)
Study.report(
  Study.caseN2(VV.max),
  "max",
  [
    #[#[Version(2, 0, 0), Version(1, 3, 1)], Version(1, 3, 1)],
    #[#[Version(1, 3, 1), Version(2, 0, 0)], Version(2, 0, 0)],
  ],
)
Study.report(
  Study.caseN2(VV.min),
  "min",
  [
    #[#[Version(2, 0, 0), Version(1, 3, 1)], Version(1, 3, 1)],
    #[#[Version(1, 3, 1), Version(2, 0, 0)], Version(2, 0, 0)],
  ],
)
Study.report(VV.showVersion, "showVersion", [#[Version(1, 2, 3), "1.2.3"]])
Study.report(
  Study.caseN2(VV.createRange),
  "createRange",
  [
    #[
      #[Just(Version(0, 0, 1)), Just(Version(1, 2, 3))],
      VersionRange(Version(0, 0, 1), Version(1, 2, 3)),
    ],
    #[#[Just(Version(0, 0, 1)), Nothing], FromVersion(Version(0, 0, 1))],
    #[#[Nothing, Just(Version(0, 1, 1))], UntilVersion(Version(0, 1, 1))],
    #[#[Nothing, Nothing], AnyVersion],
  ],
)
h1 = Version(0, 0, 1)
h2 = Version(0, 3, 5)
h3 = Version(0, 5, 3)
h4 = Version(1, 2, 3)
Study.report(
  Study.caseN2(VV.intersection),
  "intersects",
  [
    #[#[VersionRange(h1, h2), VersionRange(h3, h4)], VersionRange(h3, h4)],
    #[#[VersionRange(h1, h3), VersionRange(h2, h4)], VersionRange(h2, h4)],
    #[#[VersionRange(h1, h3), UntilVersion(h4)], VersionRange(h1, h4)],
    #[#[UntilVersion(h4), VersionRange(h1, h3)], VersionRange(h1, h3)],
    #[#[UntilVersion(h4), UntilVersion(h1)], UntilVersion(h1)],
    #[#[UntilVersion(h4), FromVersion(h1)], VersionRange(h1, h4)],
    #[#[FromVersion(h4), VersionRange(h1, h3)], VersionRange(h1, h3)],
    #[#[FromVersion(h4), FromVersion(h1)], FromVersion(h1)],
    // this one seems like it shouldn't be allowed, as the left is greater than the right
    #[#[VersionRange(h1, h3), FromVersion(h4)], VersionRange(h4, h3)],
    // same
    #[#[FromVersion(h4), UntilVersion(h1)], VersionRange(h4, h1)],
  ],
)
Study.report(
  VV.bumpMajor,
  "bumpMajor",
  [
    #[Version(1, 2, 3), Version(2, 0, 0)],
    #[Version(1, 0, 0), Version(2, 0, 0)],
    #[Version(0, 0, 1), Version(1, 0, 0)],
  ],
)
Study.report(
  VV.bumpMinor,
  "bumpMinor",
  [
    #[Version(1, 2, 3), Version(1, 3, 0)],
    #[Version(1, 0, 0), Version(1, 1, 0)],
    #[Version(0, 0, 1), Version(0, 1, 0)],
  ],
)
Study.report(
  VV.bumpPatch,
  "bumpPatch",
  [
    #[Version(1, 2, 3), Version(1, 2, 4)],
    #[Version(1, 0, 0), Version(1, 0, 1)],
    #[Version(1, 0, 0), Version(1, 0, 1)],
  ],
)
