import type { Maybe } from "Maybe"

import type { Version } from "@model/Version"

import { EQ, GT, LT } from "Compare"
import {} from "Json"
import P from "Json/Print"
import { Just, Nothing } from "Maybe"

import Study from "Study"

import { AnyVersion, FromVersion, UntilVersion, Version, VersionRange } from "@model/Version"
import VV from "@model/Version"



ONE_UNDER = Version(0, 9, 0)
ONE_OH = Version(1, 0, 0)
ONE_OVER = Version(1, 7, 2)
TWO_OH = Version(2, 0, 0)
TWO_OVER = Version(2, 1, 0)
compareTest = Study.report(Study.caseN2(compare))
compareTest("compare   - GT", [#[#[ONE_OH, ONE_UNDER], GT]])
compareTest("compare   - EQ", [#[#[ONE_OH, ONE_OH], EQ]])
compareTest("compare   - LT", [#[#[ONE_UNDER, ONE_OH], LT]])
scanTest = Study.report(scan)
scanTest("scan      - good", [#["2.0.0", Just(TWO_OH)]])
scanTest("scan      - missing last number", [#["2.0.", (Nothing :: Maybe Version)]])
Study.report(
  Study.caseN2(VV.isInRange),
  "isInRange",
  [
    #[#[TWO_OH, VersionRange(TWO_OH, TWO_OVER)], true],
    #[#[TWO_OH, VersionRange(ONE_OH, ONE_OVER)], false],
    #[#[TWO_OH, FromVersion(ONE_OH)], true],
    #[#[TWO_OH, FromVersion(TWO_OVER)], false],
    #[#[TWO_OH, UntilVersion(TWO_OVER)], true],
    #[#[TWO_OH, UntilVersion(ONE_OVER)], false],
  ],
)
Study.report(VV.bumpMajor, "bumpMajor", [#[ONE_OH, TWO_OH]])
Study.report(VV.bumpMinor, "bumpMinor", [#[ONE_OH, Version(1, 1, 0)]])
Study.report(VV.bumpPatch, "bumpPatch", [#[ONE_OH, Version(1, 0, 1)]])
Study.report(
  Study.caseN2(VV.createRange),
  "createRange",
  [
    #[#[Just(ONE_OH), Just(TWO_OH)], VersionRange(ONE_OH, TWO_OH)],
    #[#[Nothing, Just(TWO_OH)], UntilVersion(TWO_OH)],
    #[#[Just(TWO_OH), Nothing], FromVersion(TWO_OH)],
  ],
)
Study.report(VV.max(TWO_OH), "max", [#[ONE_OH, TWO_OH], #[TWO_OVER, TWO_OVER]])
Study.report(VV.min(TWO_OH), "min", [#[ONE_OH, ONE_OH], #[TWO_OVER, TWO_OH]])
Study.report(
  Study.caseN2(VV.intersectRanges),
  "intersectRanges",
  [
    #[
      #[VersionRange(ONE_UNDER, ONE_OH), VersionRange(ONE_OH, ONE_OVER)],
      VersionRange(ONE_OH, ONE_OH),
    ],
    #[#[VersionRange(ONE_UNDER, ONE_OH), UntilVersion(ONE_OH)], VersionRange(ONE_UNDER, ONE_OH)],
    #[#[VersionRange(ONE_UNDER, ONE_OH), FromVersion(ONE_UNDER)], VersionRange(ONE_UNDER, ONE_OH)],
    #[#[UntilVersion(ONE_OH), VersionRange(ONE_UNDER, ONE_OH)], VersionRange(ONE_UNDER, ONE_OH)],
    #[#[UntilVersion(ONE_OH), FromVersion(ONE_OH)], VersionRange(ONE_OH, ONE_OH)],
    #[#[UntilVersion(ONE_OH), UntilVersion(ONE_OVER)], UntilVersion(ONE_OH)],
    #[#[FromVersion(ONE_OH), FromVersion(ONE_OVER)], FromVersion(ONE_OVER)],
    #[#[FromVersion(ONE_OH), UntilVersion(ONE_OVER)], VersionRange(ONE_OH, ONE_OVER)],
    #[#[FromVersion(ONE_UNDER), VersionRange(ONE_OH, ONE_OVER)], VersionRange(ONE_OH, ONE_OVER)],
  ],
)
Study.report(
  VV.toJsonPairs,
  "toJsonPairs",
  [
    #[
      VersionRange(ONE_OH, TWO_OH),
      [#["minVersion", P.string("1.0.0")], #["maxVersion", P.string("2.0.0")]],
    ],
    #[FromVersion(ONE_OH), [#["minVersion", P.string("1.0.0")]]],
    #[UntilVersion(TWO_OH), [#["maxVersion", P.string("2.0.0")]]],
    #[AnyVersion, []],
  ],
)
