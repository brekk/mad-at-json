import type { Maybe } from "Maybe"
import type { Wish } from "Wish"

import type { Context } from "@/Context"
import type { Dependency } from "@/Parse/Dependency"
import type { MadlibDotJson } from "@/Parse/MadlibJson"
import type { VersionDotLock } from "@/Parse/VersionLock"
import type { Validate, ValidationInput, ValidationOutput } from "@/Validate"

import { liftA3 } from "Applicative"
import { gt } from "Compare"
import Dictionary from "Dictionary"
import Directory from "Directory"
import File from "File"
import Fn from "Function"
import IO from "IO"
import List from "List"
import { Just, Nothing, fromMaybe } from "Maybe"
import { andDo } from "Monad"
import Process from "Process"
import String from "String"
import Tuple from "Tuple"
import Wish from "Wish"

import Shroud from "shroud"

import Color from "@/Color"
import Constants from "@/Constants"
import { addInstalledPackage, hasPackageBeenInstalled, initialContext } from "@/Context"
import { DownloadError, Downloaded, downloadIfNotCached } from "@/Download"
import { CopyToMadlibModulesFailed, MadlibDotJsonCouldNotBeLoaded, printError } from "@/Error"
import MadlibDotJson from "@/Parse/MadlibJson"
import VersionDotLock from "@/Parse/VersionLock"
import {
  NotValid,
  Valid,
  ValidationError,
  failWithRecoverable,
  unsafeGetValidationValue,
  validate,
} from "@/Validate"
import Version from "@/Version"
import { BuildHashCouldNotBeGenerated, VersionDotLockMissing, printWarning } from "@/Warning"



K = Fn.always
I = Fn.identity
copyPackageToMadlibModules :: Dependency -> Wish Process.CommandResult Process.CommandResult
copyPackageToMadlibModules = ({ name, sanitizedUrl }) => Shroud.cover(
  "cp",
  [
    "-R",
    mappend(Constants.MADLIB_MODULES_PATH, name),
    mappend(Constants.TEMPORARY_MODULES_PATH, sanitizedUrl ++ "/"),
  ],
)
installNodeModules :: String -> Wish {} String
installNodeModules = (pkgName) => pipe(
  mappend(Constants.MADLIB_MODULES_PATH),
  (path) => File.exists(`${path}package.json`) |> andDo(of(path)),
  Wish.mapRej(K("")),
  map(List.append($, ["install"])),
  chain(
    pipe(
      Shroud.cover("npm", $),
      Wish.mapRej(.stderr),
    ),
  ),
  map(.stdout),
  map(IO.putLineAndPass(`nodejs modules installed for '${pkgName}'`)),
  Wish.discardError(IO.putLineAndPass(`No node modules to install for '${pkgName}'`)),
)(pkgName)
initMadlibModulesFolder :: String -> a -> Wish String a
initMadlibModulesFolder = (path, a) => pipe(
  Shroud.cover("mkdir"),
  Wish.mapRej(.stderr),
  andDo(of(a)),
)(["-p", path])
projectBaseUrl :: Dependency -> String
projectBaseUrl = (dependency) => `${Constants.TEMPORARY_MODULES_PATH}${dependency.sanitizedUrl}`
readMadlibDotJson :: Dependency -> Wish {} (Validate MadlibDotJson)
readMadlibDotJson = (dependency) => pipe(
  MadlibDotJson.load,
  map(Valid),
  Wish.discardError(
    pipe(
      MadlibDotJsonCouldNotBeLoaded,
      ValidationError([], $, Nothing),
    ),
  ),
)(`${projectBaseUrl(dependency)}/madlib.json`)
readVersionDotLock :: Dependency -> Wish {} (Validate (Maybe VersionDotLock))
readVersionDotLock = pipe(
  projectBaseUrl,
  mappend("/version.lock"),
  VersionDotLock.load,
  map(
    pipe(
      Just,
      Valid,
    ),
  ),
  Wish.discardError(K(NotValid([VersionDotLockMissing], Nothing))),
)
computeBuildHash :: Dependency -> Wish {} (Validate String)
computeBuildHash = pipe(
  projectBaseUrl,
  List.append($, ["package", "generate-hash", "-i"]),
  Shroud.cover("madlib"),
  map(
    pipe(
      .stdout,
      Valid,
    ),
  ),
  Wish.discardError(K(NotValid([BuildHashCouldNotBeGenerated], ""))),
)
prepareValidationInput :: Dependency -> Wish {} (Validate ValidationInput)
prepareValidationInput = (dependency) => pipe(
  readVersionDotLock,
  map(
    liftA3(
      (versionDotLock, computedBuildHash, madlibDotJson) => (
        {
          madlibDotJson,
          versionDotLock,
          computedVersionHash: Version.hash(madlibDotJson.version),
          computedBuildHash,
        }
      ),
    ),
  ),
  ap($, computeBuildHash(dependency)),
  ap($, readMadlibDotJson(dependency)),
)(dependency)
formatCopyError :: String -> String
formatCopyError = (err) => pipe(
  String.lines,
  Fn.ifElse(
    pipe(
      List.length,
      gt($, 5),
    ),
    pipe(
      List.slice(0, 5),
      mappend($, ["..."]),
    ),
    I,
  ),
  map((line) => `    ${line}`),
  String.unlines,
)(err)
copyPackageFromTmp :: Validate ValidationOutput -> Wish {} (Validate ValidationOutput)
copyPackageFromTmp = (validationResult) => where(validationResult) {
  ValidationError(_, _, _) =>
    of(validationResult)

  _ =>
    pipe(
      unsafeGetValidationValue,
      Fn.ifElse(
        .shouldCopy,
        pipe(
          .dependency,
          copyPackageToMadlibModules,
          andDo(of(validationResult)),
        ),
        K(of(validationResult)),
      ),
      Wish.discardError(
        (commandError) => pipe(
          unsafeGetValidationValue,
          .madlibDotJson,
          .name,
          (n) => failWithRecoverable(
            CopyToMadlibModulesFailed(
              `Failed to copy '${n}'${formatCopyError(commandError.stderr)}`,
            ),
            validationResult,
          ),
        )(validationResult),
      ),
    )(validationResult)
}
displayInstalling :: Validate ValidationOutput -> Validate ValidationOutput
displayInstalling = (validation) => {
  validationOutput = unsafeGetValidationValue(validation)
  name = validationOutput.madlibDotJson.name
  version = Version.showVersion(validationOutput.madlibDotJson.version)

  IO.putLine(`Installing ${name} version ${version}`)

  return validation
}
displayResult :: Validate ValidationOutput -> Validate ValidationOutput
displayResult = (validation) => where(validation) {
  Valid(a) =>
    pipe(
      displayInstalling,
      Color.tabGreen("Installed!"),
    )(validation)

  NotValid(warnings, a) =>
    pipe(
      displayInstalling,
      List.reduce(printWarning, $, warnings),
      Color.tabYellow("Installed, with some issues"),
    )(validation)

  ValidationError(warnings, err, maybeA) =>
    pipe(
      where {
        Just(a) =>
          displayInstalling(of(a))

        Nothing =>
          validation
      },
      K(err),
      List.reduce(printWarning, $, warnings),
      printError(validation),
    )(maybeA)
}
tryRecovery :: Validate a -> Validate a
tryRecovery = (validation) => where(validation) {
  ValidationError(_, _, Just(a)) =>
    pure(a)

  _ =>
    validation
}
runPostInstallHook :: Boolean -> MadlibDotJson -> a -> Wish {} a
runPostInstallHook = (isMainPackage, madlibDotJson, passThrough) => pipe(
  .hooks,
  chain(Dictionary.get("postInstall")),
  where {
    Just(script) =>
      do {
        cwd = isMainPackage ? "./" : `madlib_modules/${madlibDotJson.name}`
        IO.putLine(
          `Executing postInstall script for package '${madlibDotJson.name}', it may take a while.`,
        )
        _ <- Process.exec("sh", ["-c", script], { ...Process.DEFAULT_COMMAND_OPTIONS, cwd })
        IO.putLine(`postInstall script executed for package '${madlibDotJson.name}'`)
        return of({})
      }

    _ =>
      of({})
  },
  Wish.mapRej(
    (result) => {
      IO.putLine(result.stdout)
      IO.putLine(result.stderr)
      return {}
    },
  ),
  andDo(of(passThrough)),
)(madlibDotJson)
postProcess :: #[Context, List Dependency]
  -> Dependency
  -> Validate ValidationOutput
  -> Wish {} #[Context, List Dependency]
postProcess = (previousContextAndDeps, processedDependency, validation) => where(validation) {
  ValidationError(_, _, _) =>
    of(previousContextAndDeps)

  v =>
    do {
      result = unsafeGetValidationValue(v)
      return pipe(
        (validationResult) => (
          {
            ...validationResult,
            context: addInstalledPackage(
              processedDependency.sanitizedUrl,
              validationResult.context,
            ),
          }
        ),
        (validationResult) => validationResult.shouldCopy
          ? #[
            validationResult.context,
            mappend(
              Tuple.snd(previousContextAndDeps),
              fromMaybe([], validationResult.madlibDotJson.dependencies),
            ),
          ]
          : #[validationResult.context, Tuple.snd(previousContextAndDeps)],
        runPostInstallHook(false, result.madlibDotJson),
      )(result)
    }
}
processDependency :: #[Context, List Dependency]
  -> Dependency
  -> Wish {} #[Context, List Dependency]
processDependency = (contextAndNextDeps, dependency) => pipe(
  prepareValidationInput,
  map(chain(validate(Tuple.fst(contextAndNextDeps), dependency))),
  chain(copyPackageFromTmp),
  map(
    pipe(
      displayResult,
      tryRecovery,
    ),
  ),
  chain(postProcess(contextAndNextDeps, dependency)),
  map(IO.newLine),
)(dependency)
filterAlreadyInstalledDependencies :: Context -> List Dependency -> List Dependency
filterAlreadyInstalledDependencies = (context, dependencies) => List.filter(
  pipe(
    .sanitizedUrl,
    hasPackageBeenInstalled($, context),
    Fn.not,
  ),
)(dependencies)
processDependencies :: Context -> List Dependency -> Wish {} #[Context, List Dependency]
processDependencies = (context, dependencies) => pipe(
  filterAlreadyInstalledDependencies(context),
  pipe(
    map(downloadIfNotCached),
    Wish.parallel,
  ),
  map(
    List.mapMaybe(
      where {
        DownloadError(err) =>
          IO.putLineAndPass(Color.red(err), Nothing)

        Downloaded(a) =>
          Just(a)
      },
    ),
  ),
  chain(List.reduceM(processDependency, #[context, []])),
  chain(
    where {
      #[_context, []] =>
        of(#[_context, []])

      #[_context, nextDependencies] =>
        processDependencies(_context, nextDependencies)
    },
  ),
)(dependencies)
installedDependencyFolders :: {} -> Wish {} (List String)
installedDependencyFolders = () => pipe(
  Directory.read,
  Wish.discardError(K([])),
)(Constants.MADLIB_MODULES_PATH)
consumeAndInstallPackages = (context, madlibDotJson) => pipe(
  .dependencies,
  fromMaybe([]),
  processDependencies(context),
  andDo(installedDependencyFolders()),
  chain(
    pipe(
      map(installNodeModules),
      Wish.parallel,
    ),
  ),
  chain(runPostInstallHook(true, madlibDotJson)),
)(madlibDotJson)
installPackages :: Context -> String -> Wish {} (List String)
installPackages = (context, madlibDotJsonPath) => pipe(
  File.read,
  Wish.mapRej(K(Constants.MADLIB_NOT_FOUND)),
  chain(initMadlibModulesFolder(Constants.MADLIB_MODULES_PATH)),
  Wish.discardError(I),
  chain(
    pipe(
      MadlibDotJson.parse,
      Wish.bichain(
        pipe(
          IO.putLine,
          K(of([])),
        ),
        consumeAndInstallPackages(context),
      ),
    ),
  ),
)(madlibDotJsonPath)
/**
 * prepare runs before everything and takes care of creating a temporary folder
 * as well as reading and saving the content of the package.json file in-memory
 * in order to restore it at it end
 */
prepare :: String -> Wish String String
prepare = (packageDotJsonPath) => pipe(
  Shroud.cover("mkdir"),
  andDo(of(packageDotJsonPath)),
  Wish.mapRej(.stderr),
  chain(
    pipe(
      File.exists,
      Wish.mapRej(K("")),
      map(K(packageDotJsonPath)),
    ),
  ),
  chain(
    (path) => pipe(
      Shroud.cover($, ["i"]),
      Wish.mapRej(.stderr),
      andDo(of(path)),
    )("npm"),
  ),
  chain(
    pipe(
      File.read,
      Wish.mapRej(K("")),
    ),
  ),
)(["-p", Constants.TEMPORARY_MODULES_PATH])
restorePackageDotJson :: String -> Wish {} {}
restorePackageDotJson = pipe(
  File.write("package.json"),
  Wish.mapRej(K({})),
)
run :: {} -> Wish {} {}
export run = () => {
  IO.putLine("Installing dependencies ...")

  return pipe(
    prepare,
    Wish.bichain(
      pipe(
        K("madlib.json"),
        installPackages(initialContext),
        Wish.mapRej(IO.trace("it failed!")),
      ),
      (packageDotJsonContent) => pipe(
        installPackages(initialContext),
        chain((x) => restorePackageDotJson(packageDotJsonContent) |> andDo(of(x))),
        Wish.chainRej((x) => restorePackageDotJson(packageDotJsonContent) |> andDo(Wish.bad(x))),
      )("madlib.json"),
    ),
    andDo(of({})),
  )("package.json")
}
