import type { Maybe } from "Maybe"
import type { Wish } from "Wish"

import type { Config } from "@model/Config"
import type { Options } from "@model/ConflictResolver"
import type { Context } from "@model/Context"
import type { Dependency } from "@model/Dependency"
import type { DownloadResult } from "@model/Download"
import type { MadlibDotJson } from "@model/MadlibDotJson"
import type { LockEntry } from "@model/MadlibLock"
import type { MadlibLock } from "@model/MadlibLock"
import type { Reporter } from "@model/Reporter"
import type { Validate, ValidationInput, ValidationOutput } from "@model/Validate"
import type { VersionDotLock } from "@model/VersionDotLock"

import { liftA3 } from "Applicative"
import Dictionary from "Dictionary"
import { always, identity, not } from "Function"
import IO from "IO"
import List from "List"
import { Just, Nothing, fromMaybe } from "Maybe"
import { andDo } from "Monad"
import Process from "Process"
import Tuple from "Tuple"
import { bad, bichain, chainRej, discardError, good, mapRej, parallelN } from "Wish"

import ConflictResolver from "@model/ConflictResolver"
import Constants from "@model/Constants"
import { addInstalledPackage, addLockEntry, hasPackageBeenInstalled } from "@model/Context"
import Dependency from "@model/Dependency"
import { DownloadError, Downloaded, downloadIfNotCached } from "@model/Download"
import { FromCache, FromRemote, downloadErrorMessage } from "@model/Download"
import MadlibDotJson from "@model/MadlibDotJson"
import MadlibLock from "@model/MadlibLock"
import Reporter from "@model/Reporter"
import { sanitizeUrl } from "@model/URL"
import {
  BuildHashCouldNotBeGenerated,
  MadlibDotJsonCouldNotBeLoaded,
  NotValid,
  Valid,
  ValidationError,
  VersionDotLockMissing,
  errorMessage,
  unsafeGetValidationValue,
  validate,
  warningMessage,
} from "@model/Validate"
import Version from "@model/Version"
import { AnyVersion } from "@model/Version"
import VersionDotLock from "@model/VersionDotLock"



pathing = (k) => pipe(
  mappend(k),
  mappend($, "/"),
)
madpathFolder = pathing(Constants.MADLIB_MODULES_PATH)
madtempFolder = pathing(Constants.TEMPORARY_MODULES_PATH)
installNodeModules :: Config -> String -> Wish String String
installNodeModules = (config, pkgName) => {
  path = madpathFolder(pkgName)
  return pipe(
    mappend($, "package.json"),
    config.exists,
    bichain(
      always(of("")),
      (_) => pipe(
        mapRej(.stderr),
        map(.stdout),
        map(IO.putLineAndPass(`nodejs modules installed for '${pkgName}'`)),
      )(config.exec("npm", ["install", path], Process.DEFAULT_COMMAND_OPTIONS)),
    ),
  )(path)
}
projectBaseUrl :: Dependency -> String
projectBaseUrl = pipe(
  .sanitizedUrl,
  mappend(Constants.TEMPORARY_MODULES_PATH),
)
readMadlibDotJson :: Config -> Dependency -> Wish {} (Validate MadlibDotJson)
readMadlibDotJson = (config, dependency) => pipe(
  projectBaseUrl,
  mappend($, "/madlib.json"),
  MadlibDotJson.load(config),
  map(Valid),
  discardError(
    pipe(
      MadlibDotJsonCouldNotBeLoaded,
      ValidationError([], $, Nothing),
    ),
  ),
)(dependency)
readVersionDotLock :: Config -> Dependency -> Wish {} (Validate (Maybe VersionDotLock))
readVersionDotLock = (config, dependency) => pipe(
  projectBaseUrl,
  mappend($, "/version.lock"),
  VersionDotLock.load(config),
  map(
    pipe(
      Just,
      Valid,
    ),
  ),
  discardError(always(NotValid([VersionDotLockMissing], Nothing))),
)(dependency)
computeBuildHash :: Config -> Dependency -> Wish {} (Validate String)
computeBuildHash = (config, dependency) => pipe(
  (d) => config.exec(
    "madlib",
    ["package", "generate-hash", "-i", projectBaseUrl(d)],
    Process.DEFAULT_COMMAND_OPTIONS,
  ),
  map(.stdout),
  map(Valid),
  discardError(always(NotValid([BuildHashCouldNotBeGenerated], ""))),
)(dependency)
computeVersionHash = (versionDotLock, computedBuildHash, madlibDotJson) => (
  {
    madlibDotJson,
    versionDotLock,
    computedVersionHash: Version.hash(madlibDotJson.version),
    computedBuildHash,
  }
)
prepareValidationInput :: Config -> Dependency -> Wish {} (Validate ValidationInput)
prepareValidationInput = (config, dependency) => pipe(
  readVersionDotLock(config),
  map(liftA3(computeVersionHash)),
  ap($, computeBuildHash(config, dependency)),
  ap($, readMadlibDotJson(config, dependency)),
)(dependency)
tryRecovery :: Validate a -> Validate a
tryRecovery = (v) => where(v) {
  _ =>
    v
}
runPostInstallHook :: Boolean -> MadlibDotJson -> a -> Wish {} a
runPostInstallHook = (isMainPackage, madlibDotJson, passThrough) => pipe(
  .hooks,
  chain(Dictionary.get("postInstall")),
  where {
    Just(script) =>
      do {
        cwd = isMainPackage ? "./" : `madlib_modules/${madlibDotJson.name}`
        IO.putLine(
          `Executing postInstall script for package '${madlibDotJson.name}', it may take a while.`,
        )
        _ <- Process.exec("sh", ["-c", script], { ...Process.DEFAULT_COMMAND_OPTIONS, cwd })
        IO.putLine(`postInstall script executed for package '${madlibDotJson.name}'`)
        return of({})
      }

    _ =>
      of({})
  },
  mapRej(
    (result) => {
      IO.putLine(result.stdout)
      IO.putLine(result.stderr)
      return {}
    },
  ),
  andDo(of(passThrough)),
)(madlibDotJson)
postProcess :: #[Context, List Dependency]
  -> Dependency
  -> Validate ValidationOutput
  -> Wish {} #[Context, List Dependency]
postProcess = (prev, { sanitizedUrl, url }, validation) => where(validation) {
  ValidationError(_, _, _) =>
    of(prev)

  v =>
    do {
      res = unsafeGetValidationValue(v)
      { madlibDotJson, buildHash, versionHash } = res
      { name, version, dependencies: deps } = madlibDotJson
      lockEntry = {
        name,
        version: Version.showVersion(version),
        buildHash,
        versionHash,
        dependencies: pipe(
          fromMaybe([]),
          map(.url),
        )(deps),
      }
      return pipe(
        (val) => (
          {
            ...val,
            context: pipe(
              .context,
              addInstalledPackage(sanitizedUrl),
              addLockEntry(url, lockEntry),
            )(val),
          }
        ),
        (val) => of(#[
          val.context,
          mappend(Tuple.snd(prev), fromMaybe([], val.madlibDotJson.dependencies)),
        ]),
      )(res)
    }
}
lookupSourceLockEntry :: Context -> Dependency -> Maybe LockEntry
lookupSourceLockEntry = ({ sourceLockEntries: source }, { url: key }) => (
  Dictionary.get(key, source)
)
installedDependencyChildren :: Context -> List Dependency -> List Dependency
installedDependencyChildren = (context, dependencies) => pipe(
  List.mapMaybe(
    pipe(
      lookupSourceLockEntry(context),
      where {
        Just(entry) =>
          pipe(
            .dependencies,
            map(Dependency.create),
            Just,
          )(entry)

        _ =>
          Nothing
      },
    ),
  ),
  List.flatten,
)(dependencies)
recordInstalledDependencies :: Context -> List Dependency -> Context
recordInstalledDependencies = (context, installedDependencies) => List.reduce(
  (acc, dependency) => pipe(
    lookupSourceLockEntry(acc),
    where {
      Just(entry) =>
        pipe(
          addInstalledPackage(dependency.sanitizedUrl),
          addLockEntry(dependency.url, entry),
        )(acc)

      Nothing =>
        acc
    },
  )(dependency),
  context,
  installedDependencies,
)
isDownloadError :: DownloadResult -> Boolean
isDownloadError = where {
  DownloadError(_, _) =>
    true

  _ =>
    false
}
downloadedDependency :: DownloadResult -> Maybe Dependency
downloadedDependency = where {
  DownloadError(_, _) =>
    Nothing

  Downloaded(a, _) =>
    Just(a)
}
announceInvalid = (reporter, a, warnings) => List.forEach(
  pipe(
    warningMessage,
    mappend(a.madlibDotJson.name ++ ": "),
    reporter.reportedWarning,
  ),
  warnings,
)
processDependency :: Config
  -> Reporter
  -> #[Context, List Dependency]
  -> Dependency
  -> Wish {} #[Context, List Dependency]
processDependency = (config, reporter, contextAndNextDeps, dependency) => pipe(
  (d) => {
    reporter.validating(d.url)
    return d
  },
  prepareValidationInput(config),
  map(chain(validate(Tuple.fst(contextAndNextDeps), dependency))),
  map(
    (validation) => {
      where(validation) {
        Valid(a) =>
          reporter.installing(a.madlibDotJson.name)

        NotValid(warnings, a) =>
          do {
            reporter.installing(a.madlibDotJson.name)
            announceInvalid(reporter, a, warnings)
          }

        ValidationError(warnings, err, maybeA) =>
          do {
            where(maybeA) {
              Just(a) =>
                reporter.installing(a.madlibDotJson.name)

              Nothing =>
                {}
            }
            List.forEach(
              pipe(
                warningMessage,
                reporter.reportedWarning,
              ),
              warnings,
            )
            reporter.failed(errorMessage(err))
          }
      }

      return tryRecovery(validation)
    },
  ),
  chain(
    (validation) => where(validation) {
      ValidationError(_, _, _) =>
        bad({})

      _ =>
        postProcess(contextAndNextDeps, dependency, validation)
    },
  ),
)(dependency)
filterAlreadyInstalledDependencies :: Context -> List Dependency -> List Dependency
filterAlreadyInstalledDependencies = (context, dependencies) => List.filter(
  pipe(
    .sanitizedUrl,
    hasPackageBeenInstalled($, context),
    not,
  ),
)(dependencies)
processDependencies :: Config
  -> Reporter
  -> Context
  -> List Dependency
  -> Wish {} #[Context, List Dependency]
processDependencies = (config, reporter, context, dependencies) => {
  pending = filterAlreadyInstalledDependencies(context, dependencies)
  installed = List.filter(
    ({ sanitizedUrl }) => hasPackageBeenInstalled(sanitizedUrl, context),
    dependencies,
  )
  contextWithInstalled = recordInstalledDependencies(context, installed)
  installedChildren = installedDependencyChildren(contextWithInstalled, installed)

  reporter.scheduled(List.length(pending))

  return List.isEmpty(pending)
    ? List.isEmpty(installedChildren)
      ? of(#[contextWithInstalled, installedChildren])
      : processDependencies(config, reporter, contextWithInstalled, installedChildren)
    : pipe(
      map(
        (dependency) => {
          reporter.downloading(dependency.url)
          return pipe(
            downloadIfNotCached(config, reporter.progress(dependency.url)),
            map(
              (result) => {
                where(result) {
                  Downloaded(d, FromCache) =>
                    reporter.cached(d.url)

                  Downloaded(d, FromRemote) =>
                    reporter.downloaded(d.url)

                  DownloadError(d, failure) =>
                    do {
                      reporter.downloadFinished(d.url)
                      reporter.failed(downloadErrorMessage(d, failure))
                    }
                }
                return result
              },
            ),
          )(dependency)
        },
      ),
      parallelN(8),
      chain(
        (results) => List.any(isDownloadError, results)
          ? bad({})
          : (
            chain(
              List.reduceM(processDependency(config, reporter), #[contextWithInstalled, []]),
              good(List.mapMaybe(downloadedDependency, results)),
            )
          ),
      ),
      chain(
        where {
          #[_context, []] =>
            of(#[_context, []])

          #[_context, nextDependencies] =>
            processDependencies(
              config,
              reporter,
              _context,
              mappend(nextDependencies, installedDependencyChildren(_context, installed)),
            )
        },
      ),
    )(pending)
}
installedDependencyFolders :: Config -> Wish {} (List String)
installedDependencyFolders = (config) => pipe(
  config.readDir,
  discardError(always([])),
)(Constants.MADLIB_MODULES_PATH)
sameLockName = (a, b) => a.name == b.name
sameVersion = (a, b) => a.version == b.version
sameBuildHash = (a, b) => a.buildHash == b.buildHash
sameVersionHash = (a, b) => a.versionHash == b.versionHash
sameLockEntry :: LockEntry -> LockEntry -> Boolean
sameLockEntry = (a, b) => (
  sameLockName(a, b) && sameVersion(a, b) && sameBuildHash(a, b) && sameVersionHash(a, b)
)
canReusePackage :: Config -> MadlibLock -> String -> LockEntry -> Wish {} Boolean
canReusePackage = (config, previousLock, url, entry) => where(
  Dictionary.get(url, previousLock.packages)
) {
  Just(previous) =>
    sameLockEntry(previous, entry)
      ? pipe(
        map(
          (installed) => (installed.name == entry.name)
              && (Version.showVersion(installed.version) == entry.version),
        ),
        discardError(always(false)),
      )(MadlibDotJson.load(config, `${Constants.MADLIB_MODULES_PATH}${entry.name}/madlib.json`))
      : of(false)

  Nothing =>
    of(false)
}
swapStagedPackage :: Config -> String -> String -> String -> Wish {} {}
swapStagedPackage = (config, destination, staging, backup) => pipe(
  discardError(always(false)),
  chain(
    (destinationExists) => !destinationExists
      ? pipe(
        mapRej(always({})),
      )(config.rename(staging, destination))
      : do {
        _ <- pipe(
          discardError(always({})),
        )(config.remove(backup, { recursive: true }))
        _ <- pipe(
          mapRej(always({})),
        )(config.rename(destination, backup))
        _ <- pipe(
          mapRej(always({})),
          chainRej(
            (err) => pipe(
              discardError(always({})),
              andDo(bad(err)),
            )(config.rename(backup, destination)),
          ),
        )(config.rename(staging, destination))
        return pipe(
          discardError(always({})),
        )(config.remove(backup, { recursive: true }))
      },
  ),
)(config.exists(destination))
materializePackage :: Config -> MadlibLock -> #[String, LockEntry] -> Wish {} {}
materializePackage = (config, previousLock, pair) => where(pair) {
  #[url, entry] =>
    pipe(
      canReusePackage(config, previousLock, url),
      chain(
        (reuse) => reuse
          ? of({})
          : do {
            destination = madpathFolder(entry.name)
            staging = madpathFolder(".madlib-stage")
            backup = madpathFolder(".madlib-backup")
            _ <- pipe(
              discardError(always({})),
            )(config.remove(staging, { recursive: true }))
            _ <- pipe(
              sanitizeUrl,
              madtempFolder,
              config.copy($, staging, { recursive: true, overwrite: true, exclude: [] }),
              mapRej(always({})),
            )(url)
            _ <- swapStagedPackage(config, destination, staging, backup)
            madlibDotJson <- pipe(
              sanitizeUrl,
              madtempFolder,
              mappend($, "madlib.json"),
              MadlibDotJson.load(config),
              mapRej(always({})),
            )(url)
            return runPostInstallHook(false, madlibDotJson, {})
          },
      ),
    )(entry)
}
materializeResolved :: Config -> MadlibLock -> MadlibDotJson -> MadlibLock -> Wish {} MadlibLock
materializeResolved = (config, previousLock, rootMadlibDotJson, resolvedLock) => do {
  _ <- List.reduceM(
    (_, pair) => materializePackage(config, previousLock, pair),
    {},
    Dictionary.toList(resolvedLock.packages),
  )
  folders <- installedDependencyFolders(config)
  _ <- pipe(
    map(installNodeModules(config)),
    parallelN(4),
    mapRej(IO.putLineAndPass($, {})),
  )(folders)
  return runPostInstallHook(true, rootMadlibDotJson, resolvedLock)
}
installPackages :: Config
  -> Reporter
  -> Options
  -> MadlibLock
  -> Context
  -> String
  -> Wish {} MadlibLock
installPackages = (config, reporter, options, previousLock, context, madlibDotJsonPath) => pipe(
  config.readFile,
  mapRej(always(Constants.MADLIB_NOT_FOUND)),
  chain(
    (content) => pipe(
      mapRej(always(Constants.MADLIB_NOT_FOUND)),
      andDo(of(content)),
    )(config.createDir(Constants.MADLIB_MODULES_PATH, { recursive: true })),
  ),
  discardError(identity),
  chain(
    pipe(
      MadlibDotJson.parse,
      bichain(
        pipe(
          IO.putLine,
          always(of(previousLock)),
        ),
        (madlibDotJson) => pipe(
          .dependencies,
          fromMaybe([]),
          processDependencies(config, reporter, context),
          chain(
            where {
              #[finalContext, _] =>
                pipe(
                  ConflictResolver.run(config, options, madlibDotJson),
                  mapRej(always({})),
                  chain(materializeResolved(config, previousLock, madlibDotJson)),
                )({
                  lockfileVersion: 2,
                  resolutions: previousLock.resolutions,
                  packages: finalContext.lockEntries,
                })
            },
          ),
        )(madlibDotJson),
      ),
    ),
  ),
)(madlibDotJsonPath)
/**
 * prepare runs before everything and takes care of creating a temporary folder
 * as well as reading and saving the content of the package.json file in-memory
 * in order to restore it at it end
 */
prepare :: Config -> String -> Wish String String
prepare = (config, packageDotJsonPath) => pipe(
  always(
    mapRej(always(""), config.createDir(Constants.TEMPORARY_MODULES_PATH, { recursive: true })),
  ),
  andDo(of(packageDotJsonPath)),
  chain(
    pipe(
      config.exists,
      mapRej(always("")),
      map(always(packageDotJsonPath)),
    ),
  ),
  chain(
    (path) => pipe(
      config.exec($, ["i"], Process.DEFAULT_COMMAND_OPTIONS),
      mapRej(.stderr),
      andDo(of(path)),
    )("npm"),
  ),
  chain(
    pipe(
      config.readFile,
      mapRej(always("")),
    ),
  ),
)(packageDotJsonPath)
restorePackageDotJson :: Config -> String -> Wish {} {}
restorePackageDotJson = (config, content) => pipe(
  config.writeFile("package.json"),
  mapRej(always({})),
)(content)
writeLockFile :: Config -> MadlibLock -> Wish {} {}
writeLockFile = (config, lock) => {
  temporaryPath = `${Constants.LOCK_FILE_PATH}.tmp`
  return pipe(
    chain((_) => config.rename(temporaryPath, Constants.LOCK_FILE_PATH)),
    mapRej((err) => IO.putLineAndPass(`Failed to write lock file: ${show(err)}`, {})),
  )(MadlibLock.write(config, temporaryPath, lock))
}
// Build a minimal Dependency for prefetch-only use (versionRange is unused by download logic).
makePrefetchDep :: String -> Dependency
makePrefetchDep = (url) => (
  {
    url,
    sanitizedUrl: sanitizeUrl(url),
    versionRange: AnyVersion,
    description: Nothing,
    name: Nothing,
  }
)
// Pre-download every package in the lock file in parallel so the project-local
// and global caches are warm before the main install loop starts.  This turns
// depth-sequential network round-trips into a single parallel fan-out for any
// graph already captured in the lock (e.g. CI with a committed lock file).
prefetchFromLock :: Config -> MadlibLock.MadlibLock -> Wish {} {}
prefetchFromLock = (config, lock) => pipe(
  Dictionary.keys,
  map((url) => andDo(of({}), downloadIfNotCached(config, (_, _) => {}, makePrefetchDep(url)))),
  parallelN(16),
  map(always({})),
)(lock.packages)
// Build a starting Context from the previous lock file. For each locked
// package, we check whether it is already present in madlib_modules/.
// Packages found on disk are marked as installed so the main loop skips
// them (delta install). The previous lock is kept as the source graph so
// already-installed packages can still contribute their transitive deps.
buildDeltaContext :: Config -> MadlibLock.MadlibLock -> Wish {} Context
buildDeltaContext = (config, lock) => pipe(
  Dictionary.toList,
  map(
    (pair) => where(pair) {
      #[url, entry] =>
        pipe(
          madpathFolder,
          mappend($, "madlib.json"),
          config.exists,
          map((_) => Just(sanitizeUrl(url))),
          discardError(always(Nothing)),
        )(entry.name)
    },
  ),
  parallelN(16),
  map(
    (results) => (
      {
        versions: Dictionary.empty,
        installedPackages: List.mapMaybe(identity, results),
        lockEntries: Dictionary.empty,
        sourceLockEntries: lock.packages,
      }
    ),
  ),
)(lock.packages)
run :: Options -> Config -> Wish {} {}
export run = (options, config) => {
  reporter = Reporter.make(config.isTTY({}), config.now({}))
  reporter.start({})

  return pipe(
    discardError(always(MadlibLock.empty)),
    chain(
      (lock) => chain(
        (_) => map((ctx) => #[lock, ctx], buildDeltaContext(config, lock)),
        prefetchFromLock(config, lock),
      ),
    ),
    chain(
      (lockAndContext) => where(lockAndContext) {
        #[lock, ctx] =>
          pipe(
            prepare(config),
            bichain(
              pipe(
                always("madlib.json"),
                installPackages(config, reporter, options, lock, ctx),
                mapRej(IO.trace("it failed!")),
              ),
              (pkgJson) => pipe(
                installPackages(config, reporter, options, lock, ctx),
                chain((finalLock) => andDo(of(finalLock), restorePackageDotJson(config, pkgJson))),
                chainRej((x) => andDo(bad(x), restorePackageDotJson(config, pkgJson))),
              )("madlib.json"),
            ),
            chain(
              (finalLock) => {
                reporter.complete({})
                return writeLockFile(config, finalLock)
              },
            ),
            chainRej(
              (x) => {
                reporter.complete({})
                return bad(x)
              },
            ),
            andDo(of({})),
          )("package.json")
      },
    ),
  )(MadlibLock.load(config, Constants.LOCK_FILE_PATH))
}
