import type { Maybe } from "Maybe"
import type { Wish } from "Wish"

import type { Proxy } from "@model/Proxy"

import ByteArray from "ByteArray"
import Dictionary from "Dictionary"
import { Left, Right } from "Either"
import { always, identity } from "Function"
import IO from "IO"
import J from "Json/Parse"
import List from "List"
import { Just, Nothing, fromMaybe } from "Maybe"
import { andDo } from "Monad"
import String from "String"
import Terminal from "Terminal"
import { Wish } from "Wish"
import { bichain, discardError, good, mapRej, parallelN } from "Wish"

import Color from "@model/Color"
import Constants from "@model/Constants"
import MadlibDotJson from "@model/MadlibDotJson"
import MadlibLock from "@model/MadlibLock"



alias GitHubInfo = { currentTag :: String, owner :: String, repo :: String }
export alias UpgradeCandidate = {
  currentUrl :: String,
  currentVersion :: String,
  latestTag :: String,
  newUrl :: String,
  packageName :: String,
}
// ---- URL helpers ------------------------------------------------------------

parseGitHubTagUrl :: String -> Maybe GitHubInfo
export parseGitHubTagUrl = (url) => where(String.split("/", url)) {
  ["https:", "", "github.com", owner, repo, "archive", "refs", "tags", tagZip] =>
    Just({ owner, repo, currentTag: String.dropLast(4, tagZip) })

  _ =>
    Nothing
}
buildNewUrl :: GitHubInfo -> String -> String
export buildNewUrl = (info, tag) => `https://github.com/${info.owner}/${
  info.repo
}/archive/refs/tags/${tag}.zip`
// ---- GitHub API -------------------------------------------------------------

checkLatestRelease :: Proxy -> GitHubInfo -> Wish {} (Maybe String)
checkLatestRelease = (proxy, info) => pipe(
  proxy.getBytes,
  map(
    (response) => pipe(
      .body,
      ByteArray.toString,
      J.parse(J.field("tag_name", J.string)),
      where {
        Right(tag) =>
          tag == info.currentTag ? Nothing : Just(tag)

        Left(_) =>
          Nothing
      },
    )(response),
  ),
  discardError(always(Nothing)),
)(`https://api.github.com/repos/${info.owner}/${info.repo}/releases/latest`)
// ---- Candidate building -----------------------------------------------------

buildCandidate :: Proxy -> String -> MadlibLock.LockEntry -> Wish {} (Maybe UpgradeCandidate)
buildCandidate = (proxy, url, entry) => where(parseGitHubTagUrl(url)) {
  Nothing =>
    of(Nothing)

  Just(info) =>
    map(
      (maybeTag) => where(maybeTag) {
        Nothing =>
          Nothing

        Just(tag) =>
          Just({
            packageName: entry.name,
            currentVersion: entry.version,
            currentUrl: url,
            newUrl: buildNewUrl(info, tag),
            latestTag: tag,
          })
      },
      checkLatestRelease(proxy, info),
    )
}
buildCandidates :: Proxy -> MadlibLock.MadlibLock -> Wish {} (List UpgradeCandidate)
buildCandidates = (proxy, lock) => pipe(
  Dictionary.toList,
  map((pair) => where(pair) { #[url, entry] => buildCandidate(proxy, url, entry) }),
  parallelN(8),
  map(List.mapMaybe(identity)),
)(lock.packages)
filterRootCandidates :: Proxy -> List UpgradeCandidate -> Wish {} (List UpgradeCandidate)
filterRootCandidates = (proxy, candidates) => pipe(
  MadlibDotJson.load(proxy),
  map(
    (mdj) => {
      rootUrls = pipe(
        fromMaybe([]),
        map(.url),
      )(mdj.dependencies)
      return List.filter((candidate) => List.includes(candidate.currentUrl, rootUrls), candidates)
    },
  ),
  discardError(always(candidates)),
)("madlib.json")
// ---- Rendering helpers ------------------------------------------------------

renderCandidateLine :: Integer -> Boolean -> Integer -> UpgradeCandidate -> {}
renderCandidateLine = (cursorPos, isSelected, idx, cand) => {
  arrow = idx == cursorPos ? Color.bold(" > ") : "   "
  check = isSelected ? Color.green("[x]") : "[ ]"
  IO.put(Terminal.clearLine({}))
  IO.putLine(
    `${check}${arrow}${Color.bold(cand.packageName)}  ${Color.yellow(cand.currentVersion)} → ${
      Color.green(cand.latestTag)
    }`,
  )
}
// ---- Interactive picker (TTY) -----------------------------------------------

interactivePicker :: List UpgradeCandidate -> Wish {} (List UpgradeCandidate)
interactivePicker = (candidates) => Wish(
  (reject, resolve) => {
    count = List.length(candidates)
    cursor = 0
    selected :: List Boolean
    selected = List.repeat(true, count)
    renderedLines = 0
    handlerCell :: List Terminal.HandlerId
    handlerCell = []

    renderMenu = () => {
      if (renderedLines > 0) {
        IO.put(Terminal.moveCursorUp(renderedLines))
      } else do {
        // the formatter is insane
        return {}
      }
      IO.put(Terminal.clearLine({}))
      IO.putLine(Color.bold("Select upgrades: ") ++ "↑↓ move  space toggle  enter confirm  q quit")
      IO.put(Terminal.clearLine({}))
      IO.putLine("")
      indices = List.range(0, count)
      List.forEach(
        (triple) => where(triple) {
          #[#[cand, isSelected], idx] =>
            renderCandidateLine(cursor, isSelected, idx, cand)
        },
        List.zip(List.zip(candidates, selected), indices),
      )
      renderedLines := 2 + count
    }

    clearHandler = () => {
      List.forEach(Terminal.clearKeyPressedHandler, handlerCell)
      handlerCell := []
    }

    cleanup = () => {
      Terminal.disableTTYRawMode({})
      IO.put(Terminal.showCursor({}))
    }

    confirmSelection = () => {
      clearHandler({})
      cleanup({})
      IO.putLine("")
      selectedCandidates = List.mapMaybe(
        (pair) => where(pair) {
          #[cand, true] =>
            Just(cand)

          _ =>
            Nothing
        },
        List.zip(candidates, selected),
      )
      resolve(selectedCandidates)
    }

    cancelSelection = () => {
      clearHandler({})
      cleanup({})
      IO.putLine("")
      reject({})
    }

    doMoveUp = () => {
      cursor := cursor > 0 ? cursor - 1 : count - 1
      renderMenu({})
    }

    doMoveDown = () => {
      cursor := cursor < count - 1 ? cursor + 1 : 0
      renderMenu({})
    }

    doToggle = () => {
      selected := List.mapWithIndex((v, i) => i == cursor ? !v : v, selected)
      renderMenu({})
    }

    handleKey = (key) => where(key) {
      "\x1b[A" =>
        doMoveUp({})

      "\x1b[B" =>
        doMoveDown({})

      " " =>
        doToggle({})

      "\r" =>
        confirmSelection({})

      "q" =>
        cancelSelection({})

      "\x03" =>
        cancelSelection({})

      _ =>
        {}
    }

    Terminal.enableTTYRawMode({})
    IO.put(Terminal.hideCursor({}))
    renderMenu({})
    hid = Terminal.onKeyPressed(handleKey)
    handlerCell := [hid]

    return () => {
      clearHandler({})
      cleanup({})
    }
  },
)
// ---- Non-TTY fallback: auto-select all --------------------------------------

selectAll :: List UpgradeCandidate -> Wish {} (List UpgradeCandidate)
selectAll = (candidates) => {
  IO.putLine("")
  List.forEach(
    (cand) => IO.putLine(
      `  ${Color.bold(cand.packageName)}  ${Color.yellow(cand.currentVersion)} → ${
        Color.green(cand.latestTag)
      }`,
    ),
    candidates,
  )
  IO.putLine("")
  return of(candidates)
}
// ---- Apply selected upgrades ------------------------------------------------

applyUpgrades :: Proxy -> List UpgradeCandidate -> Wish {} {}
export applyUpgrades = (proxy, selected) => {
  updateJson = pipe(
    MadlibDotJson.load(proxy),
    mapRej(always({})),
    map(
      (mdj) => (
        {
          ...mdj,
          dependencies: map(
            (deps) => map(
              (dep) => where(List.find((c) => c.currentUrl == dep.url, selected)) {
                Just(cand) =>
                  { ...dep, url: cand.newUrl }

                Nothing =>
                  dep
              },
              deps,
            ),
            mdj.dependencies,
          ),
        }
      ),
    ),
    chain(
      (mdj) => pipe(
        proxy.writeFile("madlib.json"),
        mapRej(always({})),
      )(MadlibDotJson.serialize(mdj)),
    ),
  )("madlib.json")

  updateLock = pipe(
    MadlibLock.load(proxy),
    discardError(always(MadlibLock.empty)),
    map(
      (lock) => (
        {
          ...lock,
          packages: List.reduce(
            (dict, cand) => Dictionary.remove(cand.currentUrl, dict),
            lock.packages,
            selected,
          ),
        }
      ),
    ),
    chain(
      (lock) => pipe(
        MadlibLock.write(proxy, Constants.LOCK_FILE_PATH),
        discardError(always({})),
      )(lock),
    ),
  )(Constants.LOCK_FILE_PATH)

  return andDo(updateLock, updateJson)
}
// ---- Orchestration ----------------------------------------------------------

noUpgradesSelected :: {} -> Wish {} {}
noUpgradesSelected = (_) => {
  IO.putLine("No upgrades selected.")
  return good({})
}
runApplyUpgrades :: Proxy -> List UpgradeCandidate -> Wish {} {}
runApplyUpgrades = (proxy, selectedCandidates) => {
  count = List.length(selectedCandidates)
  IO.putLine(Color.bold("Applying upgrades..."))
  return pipe(
    chain(
      (_) => {
        IO.putLine(
          Color.green(
            `Applied ${show(count)} upgrade(s). Run madlib install to fetch the new packages.`,
          ),
        )
        IO.putLine("")
        return good({})
      },
    ),
  )(applyUpgrades(proxy, selectedCandidates))
}
applySelected :: Proxy -> List UpgradeCandidate -> Wish {} {}
applySelected = (proxy, selectedCandidates) => List.isEmpty(selectedCandidates)
  ? noUpgradesSelected({})
  : runApplyUpgrades(proxy, selectedCandidates)
noUpgradesAvailable :: {} -> Wish {} {}
noUpgradesAvailable = (_) => {
  IO.putLine(Color.green("All packages are up to date."))
  IO.putLine("")
  return good({})
}
runPicker :: Proxy -> List UpgradeCandidate -> Wish {} {}
runPicker = (proxy, candidates) => pipe(
  chain(applySelected(proxy)),
  discardError(always({})),
)(proxy.isTTY({}) ? interactivePicker(candidates) : selectAll(candidates))
processCandidates :: Proxy -> List UpgradeCandidate -> Wish {} {}
processCandidates = (proxy, candidates) => List.isEmpty(candidates)
  ? noUpgradesAvailable({})
  : runPicker(proxy, candidates)
noLockFile :: {} -> Wish {} {}
noLockFile = (_) => {
  IO.putLine(Color.yellow("madlib.lock not found — run madlib install first"))
  return good({})
}
renderLock :: Proxy -> MadlibLock.MadlibLock -> Wish {} {}
renderLock = (proxy, lock) => do {
  candidates <- buildCandidates(proxy, lock)
  filteredCandidates <- filterRootCandidates(proxy, candidates)
  _ <- processCandidates(proxy, filteredCandidates)
  return of({})
}
render :: Proxy -> Wish {} {}
export render = (proxy) => {
  IO.putLine("")
  IO.putLine("Checking for updates...")

  return pipe(
    bichain(always(noLockFile({})), renderLock(proxy)),
  )(MadlibLock.load(proxy, Constants.LOCK_FILE_PATH))
}
