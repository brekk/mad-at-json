import String from "String"



slugChar :: Char -> Char
slugChar = where {
  ':' =>
    '_'

  '/' =>
    '_'

  '#' =>
    '_'

  '.' =>
    '_'

  '?' =>
    '_'

  '&' =>
    '_'

  '=' =>
    '_'

  '-' =>
    '_'

  char =>
    char
}
sanitizeUrl :: String -> String
export sanitizeUrl = String.mapChars(slugChar)
