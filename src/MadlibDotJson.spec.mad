import ByteArray from "ByteArray"
import { always } from "Function"
import { OK } from "Http"
import { Nothing } from "Maybe"
import { ErrorWithMessage, assertEquals, test } from "Test"
import { bad, bichain, good } from "Wish"

import { load, parse } from "./MadlibDotJson"
import { Version } from "./Version"



HARNESS = {
  MADLIB_DOT_JSON_MINIMAL: `{
  "name": "SamplePackage",
  "version": "0.1.7",
  "main": "src/Main.mad"
}`,
  MADLIB_DOT_JSON_WRONG_VERSION: `{
  "name": "SamplePackage",
  "version": "0.1.a",
  "main": "src/Main.mad"
}`,
}

test(
  "parse",
  (_) => pipe(
    parse,
    bichain(
      always(bad(ErrorWithMessage("Parsing should be success!"))),
      assertEquals(
        $,
        {
          name: "SamplePackage",
          version: Version(0, 1, 7),
          main: "src/Main.mad",
          bin: Nothing,
          importAliases: Nothing,
          madlibVersion: Nothing,
          dependencies: Nothing,
          hooks: Nothing,
        },
      ),
    ),
  )(HARNESS.MADLIB_DOT_JSON_MINIMAL),
)

test(
  "parse    - wrong version",
  (_) => pipe(
    parse,
    bichain(
      assertEquals(
        $,
        "The version in the madlib.json file is not valid, you provided '0.1.a', but it should have the form x.y.z where x, y and z are numbers.",
      ),
      always(bad(ErrorWithMessage("Parsing should be failure!"))),
    ),
  )(HARNESS.MADLIB_DOT_JSON_WRONG_VERSION),
)

test(
  "load     - success",
  (_) => {
    config = {
      readFile: always(good(HARNESS.MADLIB_DOT_JSON_MINIMAL)),
      writeFile: (_, _) => good({}),
      writeBytes: (_, _) => good({}),
      readDir: always(good([])),
      exists: always(good(true)),
      exec: (_, _) => good({ exitCode: 0, stdout: "OK", stderr: "" }),
      execWithConfig: (_, _, _) => good({ exitCode: 0, stdout: "OK", stderr: "" }),
      getBytes: always(good({ body: ByteArray.empty(), headers: [], status: OK })),
    }

    expected = {
      name: "SamplePackage",
      version: Version(0, 1, 7),
      main: "src/Main.mad",
      bin: Nothing,
      importAliases: Nothing,
      madlibVersion: Nothing,
      dependencies: Nothing,
      hooks: Nothing,
    }

    return pipe(
      load(config),
      bichain(
        always(bad(ErrorWithMessage("Parsing should be success!"))),
        assertEquals($, expected),
      ),
    )("madlib.json")
  },
)
