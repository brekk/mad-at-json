import ByteArray from "ByteArray"
import { always } from "Function"
import { OK } from "Http"
import { Just, Nothing } from "Maybe"
import { ErrorWithMessage, assertEquals, test } from "Test"
import { bad, bichain, good } from "Wish"

import { load, parse } from "./MadlibDotJson"
import { sanitizeUrl } from "./URL"
import { AnyVersion } from "./Version"
import { Version } from "./Version"
import { fakeProxy } from "@model/Proxy"



MADLIB_DOT_JSON_MINIMAL = `{
  "name": "SamplePackage",
  "version": "0.1.7",
  "main": "src/Main.mad"
}`
MADLIB_DOT_JSON_WRONG_VERSION = `{
  "name": "SamplePackage",
  "version": "0.1.a",
  "main": "src/Main.mad"
}`
test(
  "parse",
  (_) => pipe(
    parse,
    bichain(
      always(bad(ErrorWithMessage("Parsing should be success!"))),
      assertEquals(
        $,
        {
          name: "SamplePackage",
          version: Version(0, 1, 7),
          main: "src/Main.mad",
          bin: Nothing,
          importAliases: Nothing,
          madlibVersion: Nothing,
          dependencies: Nothing,
          hooks: Nothing,
        },
      ),
    ),
  )(MADLIB_DOT_JSON_MINIMAL),
)
test(
  "parse - dependency description is optional",
  (_) => pipe(
    parse,
    bichain(
      always(bad(ErrorWithMessage("Parsing should be success!"))),
      assertEquals(
        $,
        {
          name: "SamplePackage",
          version: Version(0, 1, 7),
          main: "src/Main.mad",
          bin: Nothing,
          importAliases: Nothing,
          madlibVersion: Nothing,
          dependencies: Just([
            {
              description: Nothing,
              url: "https://example.com/pkg.zip",
              sanitizedUrl: sanitizeUrl("https://example.com/pkg.zip"),
              versionRange: AnyVersion,
              name: Nothing,
            },
          ]),
          hooks: Nothing,
        },
      ),
    ),
  )(
    `{
  "name": "SamplePackage",
  "version": "0.1.7",
  "main": "src/Main.mad",
  "dependencies": [{ "url": "https://example.com/pkg.zip" }]
}`,
  ),
)
test(
  "parse    - wrong version",
  (_) => pipe(
    parse,
    bichain(
      assertEquals(
        $,
        "The version in the madlib.json file is not valid, you provided '0.1.a', but it should have the form x.y.z where x, y and z are numbers.",
      ),
      always(bad(ErrorWithMessage("Parsing should be failure!"))),
    ),
  )(MADLIB_DOT_JSON_WRONG_VERSION),
)
test(
  "load     - success",
  (_) => {
    config = { ...fakeProxy, readFile: always(good(MADLIB_DOT_JSON_MINIMAL)) }

    expected = {
      name: "SamplePackage",
      version: Version(0, 1, 7),
      main: "src/Main.mad",
      bin: Nothing,
      importAliases: Nothing,
      madlibVersion: Nothing,
      dependencies: Nothing,
      hooks: Nothing,
    }

    return pipe(
      load(config),
      bichain(
        always(bad(ErrorWithMessage("Parsing should be success!"))),
        assertEquals($, expected),
      ),
    )("madlib.json")
  },
)
