import type { Value } from "Json/Value"

import type { Comparison } from "Compare"
import type { Maybe } from "Maybe"

import Compare from "Compare"
import Dictionary from "Dictionary"
import JP from "Json/Print"
import {
  JsonArray,
  JsonBoolean,
  JsonFloat,
  JsonInteger,
  JsonNull,
  JsonObject,
  JsonString,
} from "Json/Value"
import List from "List"
import { Just, Nothing } from "Maybe"
import {} from "Number"
import PP from "PrettyPrint"
import String from "String"
import Tuple from "Tuple"



// Pretty Printer
// --------------

escapeString :: String -> String
escapeString = (s) => {
  go :: List Char -> List Char
  go = (chars) => where(chars) {
    ['"', ...cs] =>
      ['\\', '"', ...go(cs)]

    ['\n', ...cs] =>
      ['\\', 'n', ...go(cs)]

    ['\t', ...cs] =>
      ['\\', 't', ...go(cs)]

    ['\r', ...cs] =>
      ['\\', 'r', ...go(cs)]

    [c, ...cs] =>
      [c, ...go(cs)]

    [] =>
      []
  }

  return pipe(
    String.toList,
    go,
    String.fromList,
  )(s)
}
export alias KeyedFold a = List String -> Maybe String -> List a -> List a
jsonToDocWithFoldAndIndent :: Integer -> Maybe String -> KeyedFold a -> Value -> PP.Doc
export jsonToDocWithFoldAndIndent = (idx, ref, fold, value) => {
  jdx = idx < 0 ? idx : idx + 1
  doIndent = idx > 0
  indentBy = doIndent ? jdx : 2
  indento = pipe(
    PP.hcat,
    PP.nest(indentBy),
  )
  refold = jsonToDocWithFoldAndIndent(jdx, $, fold)
  return where(value) {
    JsonString(s) =>
      pipe(
        escapeString,
        PP.text,
        PP.quotes,
      )(s)

    JsonBoolean(b) =>
      PP.text(show(b))

    JsonInteger(i) =>
      PP.text(show(i))

    JsonFloat(f) =>
      PP.text(show(f))

    JsonNull =>
      PP.text("null")

    JsonArray(items) =>
      PP.group(
        PP.hcat([
          PP.lbracket,
          indento([PP.linebreak, PP.sepBy(PP.hcat([PP.comma, PP.line]), map(refold(ref), items))]),
          PP.linebreak,
          PP.rbracket,
        ]),
      )

    JsonObject(fields) =>
      do {
        ff = Dictionary.keys(fields)
        return PP.group(
          PP.hcat([
            PP.lbrace,
            indento([
              PP.linebreak,
              PP.sepBy(
                PP.hcat([PP.comma, PP.line]),
                map(
                  (#[k, v]) => PP.hcat([PP.text(`"${k}"`), PP.colon, PP.space, refold(Just(k), v)]),
                  pipe(
                    Dictionary.toList,
                    fold(ff, ref),
                  )(fields),
                ),
              ),
            ]),
            PP.linebreak,
            PP.rbrace,
          ]),
        )
      }
  }
}
object :: List #[String, Value] -> Value
export object = (items) => JsonObject(Dictionary.fromList(items))
printWithFold :: KeyedFold a -> Integer -> Value -> String
export printWithFold = (fold, width, value) => pipe(
  jsonToDocWithFoldAndIndent(0, Nothing, fold),
  PP.prettyPrint(width),
)(value)
// List.sortBy(sortJsonFields),
export descending = (a, b) => where(#[a, b]) {
  #[#[k1, v1], #[k2, v2]] =>
    k1 < k2 ? Compare.LT : k1 == k2 ? Compare.EQ : Compare.GT
}
export ascending = (a, b) => where(descending(a, b)) {
  Compare.LT =>
    Compare.GT

  Compare.GT =>
    Compare.LT

  Compare.EQ =>
    Compare.EQ
}
// sort the keys alphanumerically, independent of their parent key value
print = printWithFold((_, _, list) => List.sortBy(descending, list))
export printJson = print
