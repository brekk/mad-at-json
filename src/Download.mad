import type { Wish } from "Wish"

import type { Dependency } from "@/Parse/Dependency"

import File from "File"
import FilePath from "FilePath"
import { always, ifElse } from "Function"
import Http from "Http"
import { Header, getHeader } from "Http"
import { andDo } from "Monad"
import String from "String"
import { bad, discardError, mapRej } from "Wish"

import Shroud from "shroud"

import Constants from "@/Constants"



export type DownloadFailure = DownloadFailure
export type DownloadResult = Downloaded(Dependency) | DownloadError(String)
tempPath :: String -> String
tempPath = mappend(Constants.TEMPORARY_MODULES_PATH)
cleanUp :: String -> Wish DownloadFailure String
cleanUp = (sanitizedUrl) => pipe(
  (url) => ["-r", tempPath(`${url}.zip`), tempPath(`${url}-tmp`)],
  Shroud.cover("rm"),
  map(.stdout),
  mapRej(always(DownloadFailure)),
)(sanitizedUrl)
copyPackageToTmpRoot :: String -> Wish DownloadFailure String
copyPackageToTmpRoot = (sanitizedUrl) => pipe(
  (url) => ["-R", tempPath(`${url}-tmp/${url}`), Constants.TEMPORARY_MODULES_PATH],
  Shroud.cover("cp"),
  map(.stdout),
  mapRej(always(DownloadFailure)),
)(sanitizedUrl)
unzipPkg :: String -> Wish DownloadFailure String
unzipPkg = (sanitizedUrl) => pipe(
  (url) => ["-o", "-d", tempPath(`${url}-tmp`), tempPath(`${url}.zip`)],
  Shroud.cover("unzip"),
  map(.stdout),
  mapRej(always(DownloadFailure)),
)(sanitizedUrl)
renameInnerFolder :: String -> Wish DownloadFailure String
renameInnerFolder = (sanitizedUrl) => pipe(
  (url) => ["-c", `mv ${tempPath(url ++ "-tmp/" ++ "*")} ${tempPath(url ++ "tmp/" ++ url)}`],
  Shroud.cover("sh"),
  map(.stdout),
  mapRej(always(DownloadFailure)),
)(sanitizedUrl)
extractArchive :: String -> Wish DownloadFailure String
extractArchive = (sanitizedUrl) => pipe(
  unzipPkg,
  andDo(renameInnerFolder(sanitizedUrl)),
  andDo(copyPackageToTmpRoot(sanitizedUrl)),
  andDo(cleanUp(sanitizedUrl)),
)(sanitizedUrl)
getPackageData :: String -> Wish DownloadFailure ByteArray
getPackageData = (url) => pipe(
  Http.getBytes,
  mapRej(always(DownloadFailure)),
  chain(
    (response) => where(response) {
      { status: 302 } =>
        pipe(
          getHeader("Location"),
          where {
            [Header(_, redirectUrl), ..._] =>
              getPackageData(redirectUrl)

            _ =>
              bad(DownloadFailure)
          },
        )(response)

      r =>
        of(r.body)
    },
  ),
  mapRej(always(DownloadFailure)),
)(url)
saveArchive :: Dependency -> ByteArray -> Wish DownloadFailure {}
saveArchive = (dependency, data) => pipe(
  .sanitizedUrl,
  mappend($, ".zip"),
  tempPath,
  File.writeBytes($, data),
  mapRej(always(DownloadFailure)),
)(dependency)
downloadPackageWithHttp :: Dependency -> String -> Wish {} DownloadResult
downloadPackageWithHttp = (dependency, url) => pipe(
  getPackageData,
  chain(saveArchive(dependency)),
  andDo(extractArchive(dependency.sanitizedUrl)),
  andDo(of(Downloaded(dependency))),
  discardError(always(DownloadError(`Package from '${dependency.url}' failed to be downloaded`))),
)(url)
copyLocalPackage :: Dependency -> String -> Wish {} DownloadResult
copyLocalPackage = (dependency, uri) => {
  goodUrl = tempPath(dependency.sanitizedUrl)
  local = mappend(goodUrl)
  remove = (x) => Shroud.cover("sh", ["-c", "rm -r " ++ local(x)])
  return pipe(
    String.drop(7),
    (path) => pipe(
      (p) => FilePath.joinPath([p, "madlib.json"]),
      File.exists,
      chain((exists) => exists ? of(path) : bad({})),
    )(path),
    chain(
      (path) => pipe(
        (p) => ["-c", `cp -R ${p} ${goodUrl}`],
        Shroud.cover("sh", $),
        andDo(remove("/.git")),
        andDo(remove("/madlib_modules")),
        andDo(remove("/.module_cache")),
        andDo(remove("/node_modules")),
        mapRej(always({})),
      )(path),
    ),
    andDo(of(Downloaded(dependency))),
    discardError(always(DownloadError(`Package from '${dependency.url}' failed to download`))),
  )(uri)
}
downloadPackage :: Dependency -> Wish {} DownloadResult
downloadPackage = (dependency) => pipe(
  .url,
  ifElse(
    String.startsWith("file://"),
    copyLocalPackage(dependency),
    downloadPackageWithHttp(dependency),
  ),
)(dependency)
downloadIfNotCached :: Dependency -> Wish {} DownloadResult
export downloadIfNotCached = (dependency) => pipe(
  .sanitizedUrl,
  tempPath,
  File.exists,
  map(always(true)),
  discardError(always(false)),
  chain(
    (alreadyDownloaded) => alreadyDownloaded
      ? of(Downloaded(dependency))
      : downloadPackage(dependency),
  ),
)(dependency)
