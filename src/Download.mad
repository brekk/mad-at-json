import type { Wish } from "Wish"

import type { Dependency } from "@model/Dependency"
import type { Proxy } from "@model/Proxy"

import FilePath from "FilePath"
import { always, ifElse } from "Function"
import { BadResponse, ClientError, Header, OK, getHeader } from "Http"
import { fromMaybe } from "Maybe"
import { andDo } from "Monad"
import Process from "Process"
import String from "String"
import { bad, bichain, chainRej, discardError, mapRej } from "Wish"

import Constants from "@model/Constants"



export type DownloadSource = FromCache | FromRemote
export type DownloadFailure
  = NetworkFailure(String)
  | RedirectMissingLocation(String)
  | HttpStatusFailure(Integer)
  | ArchiveWriteFailure(String)
  | ArchiveExtractFailure(String)
  | InvalidArchiveShape(String)
  | CacheValidationFailure(String)
  | LocalCopyFailure(String)
export type DownloadResult
  = Downloaded(Dependency, DownloadSource)
  | DownloadError(Dependency, DownloadFailure)
archivePath :: Dependency -> String
archivePath = (dependency) => `${Constants.TEMPORARY_MODULES_PATH}${dependency.sanitizedUrl}.zip`
extractPath :: Dependency -> String
extractPath = (dependency) => `${Constants.TEMPORARY_MODULES_PATH}${dependency.sanitizedUrl}-tmp`
cachePath :: Dependency -> String
export cachePath = (dependency) => `${Constants.TEMPORARY_MODULES_PATH}${dependency.sanitizedUrl}`
globalCacheBase :: {} -> String
globalCacheBase = () => pipe(
  Process.getEnv,
  fromMaybe("./no-home"),
  (home) => `${home}/.madlib/cache/`,
)("HOME")
globalCachePath :: Dependency -> String
globalCachePath = (dependency) => `${globalCacheBase({})}${dependency.sanitizedUrl}`
madlibJsonPath :: String -> String
madlibJsonPath = (path) => FilePath.joinPath([path, "madlib.json"])
formatHttpError = where {
  BadResponse(response) =>
    HttpStatusFailure(response.status)

  ClientError(_) =>
    NetworkFailure("request could not be completed")
}
formatDownloadFailure :: DownloadFailure -> String
export formatDownloadFailure = where {
  NetworkFailure(msg) =>
    `network error: ${msg} — check your internet connection`

  RedirectMissingLocation(url) =>
    `redirect from '${url}' did not include a Location header`

  HttpStatusFailure(404) =>
    `package not found (HTTP 404) — verify the URL in your madlib.json`

  HttpStatusFailure(status) =>
    `server responded with HTTP ${show(status)}${
      status >= 500 ? " — the package server may be temporarily unavailable, try again later" : ""
    }`

  ArchiveWriteFailure(path) =>
    `could not write archive to '${path}'`

  ArchiveExtractFailure(path) =>
    `could not extract archive into '${path}' — try deleting .module_cache/ and retrying`

  InvalidArchiveShape(msg) =>
    `invalid archive shape: ${msg} — try deleting .module_cache/ and retrying`

  CacheValidationFailure(path) =>
    `invalid cache entry at '${path}' — try deleting .module_cache/ and retrying`

  LocalCopyFailure(path) =>
    `could not copy local package from '${
      path
    }' — verify the path exists and contains a madlib.json`
}
downloadErrorMessage :: Dependency -> DownloadFailure -> String
export downloadErrorMessage = (dependency, failure) => `Package from '${
  dependency.url
}' failed to be downloaded: ${formatDownloadFailure(failure)}`
removeIfExists :: Proxy -> String -> Wish {} {}
removeIfExists = (proxy, path) => pipe(
  proxy.exists,
  bichain(always(of({})), () => discardError(always({}), proxy.remove(path, { recursive: true }))),
)(path)
validateCacheEntry :: Proxy -> Dependency -> Wish DownloadFailure {}
validateCacheEntry = (proxy, dependency) => pipe(
  cachePath,
  madlibJsonPath,
  proxy.exists,
  map(always({})),
  mapRej(always(CacheValidationFailure(cachePath(dependency)))),
)(dependency)
validateGlobalCacheEntry :: Proxy -> Dependency -> Wish {} {}
validateGlobalCacheEntry = (proxy, dependency) => pipe(
  globalCachePath,
  madlibJsonPath,
  proxy.exists,
  map(always({})),
  mapRej(always({})),
)(dependency)
copyFromGlobalToProject :: Proxy -> Dependency -> Wish {} DownloadResult
copyFromGlobalToProject = (proxy, dependency) => pipe(
  mapRej(always(LocalCopyFailure(cachePath(dependency)))),
  chain(
    (_) => pipe(
      mapRej(always(LocalCopyFailure(globalCachePath(dependency)))),
    )(
      proxy.copy(
        globalCachePath(dependency),
        cachePath(dependency),
        { recursive: true, overwrite: true, exclude: [] },
      ),
    ),
  ),
  chain((_) => validateCacheEntry(proxy, dependency)),
  andDo(of(Downloaded(dependency, FromCache))),
  discardError((failure) => DownloadError(dependency, failure)),
)(removeIfExists(proxy, cachePath(dependency)))
populateGlobalCache :: Proxy -> Dependency -> Wish {} {}
populateGlobalCache = (proxy, dependency) => pipe(
  chain(
    (_) => proxy.copy(
      cachePath(dependency),
      globalCachePath(dependency),
      { recursive: true, overwrite: true, exclude: [] },
    ),
  ),
  discardError(always({})),
)(proxy.createDir(globalCacheBase({}), { recursive: true }))
getPackageData :: Proxy -> (Integer -> Integer -> {}) -> String -> Wish DownloadFailure ByteArray
getPackageData = (proxy, onProgress, url) => pipe(
  mapRej(formatHttpError),
  chain(
    (response) => response.status == OK
      ? of(response.body)
      : (response.status == 301)
        || (response.status == 302)
        || (response.status == 303)
        || (response.status == 307)
        || (response.status == 308)
        ? pipe(
          getHeader("Location"),
          where {
            [Header(_, redirectUrl), ..._] =>
              getPackageData(proxy, onProgress, redirectUrl)

            _ =>
              bad(RedirectMissingLocation(url))
          },
        )(response)
        : bad(HttpStatusFailure(response.status)),
  ),
)(proxy.getBytesWithProgress(url, onProgress))
saveArchive :: Proxy -> Dependency -> ByteArray -> Wish DownloadFailure {}
saveArchive = (proxy, dependency, data) => pipe(
  proxy.writeBytes(archivePath(dependency)),
  mapRej(always(ArchiveWriteFailure(archivePath(dependency)))),
)(data)
promoteExtractedRoot :: Proxy -> Dependency -> String -> Wish DownloadFailure {}
promoteExtractedRoot = (proxy, dependency, extractedRoot) => pipe(
  mapRej(always(InvalidArchiveShape(`could not clean '${cachePath(dependency)}'`))),
  chain(
    (_) => pipe(
      mapRej(
        always(
          InvalidArchiveShape(`could not promote '${extractedRoot}' to '${cachePath(dependency)}'`),
        ),
      ),
    )(proxy.rename(extractedRoot, cachePath(dependency))),
  ),
)(removeIfExists(proxy, cachePath(dependency)))
normalizeExtractedArchive :: Proxy -> Dependency -> Wish DownloadFailure {}
normalizeExtractedArchive = (proxy, dependency) => {
  root = extractPath(dependency)
  promoteSingleEntry = (entry) => {
    child = FilePath.joinPath([root, entry])
    return pipe(
      bichain(always(of(false)), always(of(true))),
      chain(
        (hasManifest) => hasManifest
          ? promoteExtractedRoot(proxy, dependency, child)
          : bad(
            InvalidArchiveShape(
              "expected madlib.json at archive root or in the single top-level directory",
            ),
          ),
      ),
    )(proxy.exists(madlibJsonPath(child)))
  }

  return pipe(
    bichain(
      always(
        pipe(
          mapRej(always(InvalidArchiveShape(`could not read extracted archive '${root}'`))),
          chain(
            where {
              [entry] =>
                promoteSingleEntry(entry)

              _ =>
                bad(
                  InvalidArchiveShape(
                    "expected madlib.json at archive root or in a single top-level directory",
                  ),
                )
            },
          ),
        )(proxy.readDir(root)),
      ),
      always(promoteExtractedRoot(proxy, dependency, root)),
    ),
  )(proxy.exists(madlibJsonPath(root)))
}
extractArchive :: Proxy -> Dependency -> Wish DownloadFailure {}
extractArchive = (proxy, dependency) => pipe(
  mapRej(always(ArchiveExtractFailure(extractPath(dependency)))),
  chain(
    (_) => pipe(
      mapRej(always(ArchiveExtractFailure(extractPath(dependency)))),
    )(proxy.createDir(extractPath(dependency), { recursive: true })),
  ),
  chain(
    (_) => pipe(
      mapRej(always(ArchiveExtractFailure(extractPath(dependency)))),
    )(proxy.unzip(archivePath(dependency), extractPath(dependency))),
  ),
  chain((_) => normalizeExtractedArchive(proxy, dependency)),
  chain((_) => validateCacheEntry(proxy, dependency)),
  chain(
    (_) => pipe(
      mapRej(always(ArchiveWriteFailure(archivePath(dependency)))),
    )(removeIfExists(proxy, archivePath(dependency))),
  ),
  chain(
    (_) => pipe(
      mapRej(always(ArchiveExtractFailure(extractPath(dependency)))),
    )(removeIfExists(proxy, extractPath(dependency))),
  ),
)(removeIfExists(proxy, extractPath(dependency)))
downloadPackageWithHttp :: Proxy
  -> (Integer -> Integer -> {})
  -> Dependency
  -> String
  -> Wish {} DownloadResult
downloadPackageWithHttp = (proxy, onProgress, dependency, url) => pipe(
  mapRej(always(ArchiveWriteFailure(archivePath(dependency)))),
  chain(
    (_) => pipe(
      mapRej(always(ArchiveExtractFailure(extractPath(dependency)))),
    )(removeIfExists(proxy, extractPath(dependency))),
  ),
  chain((_) => getPackageData(proxy, onProgress, url)),
  chain(saveArchive(proxy, dependency)),
  andDo(extractArchive(proxy, dependency)),
  andDo(of(Downloaded(dependency, FromRemote))),
  chainRej(
    (failure) => pipe(
      andDo(removeIfExists(proxy, extractPath(dependency))),
      andDo(of(DownloadError(dependency, failure))),
    )(removeIfExists(proxy, archivePath(dependency))),
  ),
)(removeIfExists(proxy, archivePath(dependency)))
copyLocalPackage :: Proxy -> Dependency -> String -> Wish {} DownloadResult
copyLocalPackage = (proxy, dependency, uri) => pipe(
  String.drop(7),
  (path) => pipe(
    (p) => FilePath.joinPath([p, "madlib.json"]),
    proxy.exists,
    mapRej(always(LocalCopyFailure(path))),
    chain((exists) => exists ? of(path) : bad(LocalCopyFailure(path))),
  )(path),
  chain(
    (path) => pipe(
      mapRej(always(LocalCopyFailure(path))),
      chain(
        (_) => pipe(
          mapRej(always(LocalCopyFailure(path))),
        )(
          proxy.copy(
            path,
            cachePath(dependency),
            {
              recursive: true,
              overwrite: true,
              exclude: [".git", "madlib_modules", ".module_cache", "node_modules"],
            },
          ),
        ),
      ),
      chain((_) => validateCacheEntry(proxy, dependency)),
    )(removeIfExists(proxy, cachePath(dependency))),
  ),
  andDo(of(Downloaded(dependency, FromRemote))),
  discardError((failure) => DownloadError(dependency, failure)),
)(uri)
downloadPackage :: Proxy -> (Integer -> Integer -> {}) -> Dependency -> Wish {} DownloadResult
downloadPackage = (proxy, onProgress, dependency) => pipe(
  .url,
  ifElse(
    String.startsWith("file://"),
    copyLocalPackage(proxy, dependency),
    downloadPackageWithHttp(proxy, onProgress, dependency),
  ),
)(dependency)
downloadIfNotCached :: Proxy -> (Integer -> Integer -> {}) -> Dependency -> Wish {} DownloadResult
export downloadIfNotCached = (proxy, onProgress, dependency) => pipe(
  bichain(
    (_) => pipe(
      bichain(
        (_) => pipe(
          andDo(downloadPackage(proxy, onProgress, dependency)),
          chain(
            (result) => where(result) {
              Downloaded(d, _) =>
                andDo(of(Downloaded(d, FromRemote)), populateGlobalCache(proxy, d))

              DownloadError(_, _) =>
                of(result)
            },
          ),
        )(removeIfExists(proxy, cachePath(dependency))),
        (_) => copyFromGlobalToProject(proxy, dependency),
      ),
    )(validateGlobalCacheEntry(proxy, dependency)),
    always(of(Downloaded(dependency, FromCache))),
  ),
)(validateCacheEntry(proxy, dependency))
