import type { Value } from "Json/Value"

import type { Maybe } from "Maybe"
import type { Wish } from "Wish"

import type { Dependency } from "@model/Dependency"
import type { Proxy } from "@model/Proxy"

import { Left, Right } from "Either"
import File from "File"
import { always } from "Function"
import J from "Json/Parse"
import P from "Json/Print"
import List from "List"
import Maybe from "Maybe"
import { Just, Nothing } from "Maybe"
import Wish from "Wish"
import { bad, mapRej } from "Wish"

import Log from "@model/Log"
import Parsed from "@model/Parse/Dependency"
import Version from "@model/Version"



export alias MadlibDotJson = {
  bin :: Maybe String,
  dependencies :: Maybe (List Parsed.Dependency),
  hooks :: Maybe (Dictionary String String),
  importAliases :: Maybe (Dictionary String String),
  madlibVersion :: Maybe String,
  main :: String,
  name :: String,
  version :: Version.Version,
}
SKIP_ME = "SKIP_ME"
skippable = (a) => #[SKIP_ME, a]
eschewSkippable = List.reduce(
  (agg, x) => where(x) {
    #[k, v] =>
      k == SKIP_ME ? agg : List.append(x, agg)
  },
  [],
)
checkSkip = (encode, ww) => Maybe.isJust(ww) ? #["bin", encode(ww)] : skippable(P.string(SKIP_ME))
dineDash = checkSkip(toJson)
instance Json MadlibDotJson {
  fromJson = J.map8(
    (bin, dependencies, hooks, importAliases, madlibVersion, main, name, version) => Log
      .env
      .parseDependency(
        "y u no work?",
        { bin, dependencies, hooks, importAliases, madlibVersion, main, name, version },
      ),
    J.field("bin", J.maybe(J.string)),
    Parsed.dependenciesParser,
    J.field("hooks", J.maybe(J.dict(J.string))),
    J.field("importAliases", J.maybe(J.dict(J.string))),
    J.field("madlibVersion", J.maybe(J.string)),
    J.field("main", J.string),
    J.field("name", J.string),
    J.field("version", fromJson),
  )

  toJson = (x) => {
    return pipe(
      eschewSkippable,
      P.object,
    )([
      checkSkip((v) => P.string(v ?? SKIP_ME), x.bin),
      dineDash(x.dependencies),
      dineDash(x.hooks),
      dineDash(x.importAliases),
      checkSkip((v) => P.string(v ?? "0.0.0"), x.madlibVersion),
      #["main", P.string(x.main)],
      #["name", P.string(x.name)],
      #["version", toJson(x.version)],
    ])
  }
}
makeMadlibDotJson :: String
  -> String
  -> Maybe String
  -> Maybe (List Parsed.Dependency)
  -> String
  -> Maybe String
  -> Maybe (Dictionary String String)
  -> Maybe (Dictionary String String)
  -> J.Parser MadlibDotJson
makeMadlibDotJson = (
  name,
  version,
  madlibVersion,
  dependencies,
  main,
  bin,
  importAliases,
  hooks
) => where(Version.parse(version)) {
  Just(v) =>
    J.succeed({ name, version: v, madlibVersion, dependencies, main, bin, importAliases, hooks })

  Nothing =>
    J.fail(
      `The version in the madlib.json file is not valid, you provided '${
        version
      }', but it should have the form x.y.z where x, y and z are numbers.`,
    )
}
parser :: J.Parser MadlibDotJson
parser = J.chain8(
  makeMadlibDotJson,
  J.field("name", J.string),
  J.field("version", J.string),
  J.maybe(J.field("madlibVersion", J.string)),
  Parsed.dependenciesParser,
  J.field("main", J.string),
  J.maybe(J.field("bin", J.string)),
  J.maybe(J.field("importAliases", J.dict(J.string))),
  J.maybe(J.field("hooks", J.dict(J.string))),
)
parse :: String -> Wish String MadlibDotJson
export parse = pipe(
  J.parse(parser),
  where {
    Left(e) =>
      bad(e)

    Right(a) =>
      of(a)
  },
)
loadWithProxy :: Proxy -> String -> Wish String MadlibDotJson
export loadWithProxy = (proxy, path) => pipe(
  proxy.readFile,
  mapRej(always(`madlib.json file not found at path '${path}'`)),
  chain(parse),
  mapRej(
    mappend(
      `madlib.json file at path '${path}' is malformed
Error: `,
    ),
  ),
)(path)
export writeWithWidth = (width, jj) => pipe(
  toJson,
  P.printJson(width),
)(jj)
export write = writeWithWidth(80)
// ---- Serialization ----------------------------------------------------------

serializeDependency :: Dependency -> Value
serializeDependency = (dep) => {
  base = [#["url", P.string(dep.url)]]

  withDesc = where(dep.description) {
    Just(desc) =>
      [...base, #["description", P.string(desc)]]

    Nothing =>
      base
  }

  withMin = where(dep.versionRange) {
    Version.VersionRange(minV, _) =>
      [...withDesc, #["minVersion", P.string(Version.showVersion(minV))]]

    Version.FromVersion(minV) =>
      [...withDesc, #["minVersion", P.string(Version.showVersion(minV))]]

    _ =>
      withDesc
  }

  withMax = where(dep.versionRange) {
    Version.VersionRange(_, maxV) =>
      [...withMin, #["maxVersion", P.string(Version.showVersion(maxV))]]

    Version.UntilVersion(maxV) =>
      [...withMin, #["maxVersion", P.string(Version.showVersion(maxV))]]

    _ =>
      withMin
  }

  return P.object(withMax)
}
maybeField :: String -> (a -> Value) -> Maybe a -> List #[String, Value]
maybeField = (key, fn, maybeVal) => where(maybeVal) {
  Just(v) =>
    [#[key, fn(v)]]

  Nothing =>
    []
}
serialize :: MadlibDotJson -> String
export serialize = (mdj) => {
  fields = [
    #["name", P.string(mdj.name)],
    #["version", P.string(Version.showVersion(mdj.version))],
    #["main", P.string(mdj.main)],
  ]
    ++ maybeField("madlibVersion", P.string, mdj.madlibVersion)
    ++ maybeField("bin", P.string, mdj.bin)
    ++ maybeField("dependencies", (deps) => P.list(serializeDependency, deps), mdj.dependencies)
    ++ maybeField("importAliases", P.dict(P.string), mdj.importAliases)
    ++ maybeField("hooks", P.dict(P.string), mdj.hooks)

  return P.print(80, P.object(fields))
}
