import type { Value } from "Json/Value"

import type { Maybe } from "Maybe"

import type { VersionRange } from "@model/Version"

import J from "Json/Parse"
import P from "Json/Print"
import List from "List"
import { Just } from "Maybe"
import { Nothing } from "Maybe"
import {} from "Wish"

import Log from "@model/Log"
import { sanitizeUrl } from "@model/URL"
import Version from "@model/Version"



export alias Dependency = {
  description :: Maybe String,
  name :: Maybe String,
  sanitizedUrl :: String,
  url :: String,
  versionRange :: VersionRange,
}
instance Json Dependency {
  fromJson = dependencyParser

  toJson = serializeDependency
}
// dap up your deps
export construct = (url, description, maybeMinVersion, maybeMaxVersion, name) => Log
  .env
  .parseDependency(
    "constructing",
    {
      url,
      description,
      versionRange: Version.createRange(maybeMinVersion, maybeMaxVersion),
      name,
      sanitizedUrl: sanitizeUrl(url),
    },
  )
versionField = (key) => pipe(
  J.field($, J.string),
  J.maybe,
  J.map1(chain(Version.parse)),
)(key)
export dependencyParser = J.map5(
  construct,
  J.field("url", J.string),
  J.maybe(J.field("description", J.string)),
  versionField("minVersion"),
  versionField("maxVersion"),
  J.maybe(J.field("name", J.string)),
)
dependenciesParser :: J.Parser (Maybe (List Dependency))
export dependenciesParser = J.maybe(J.field("dependencies", J.list(dependencyParser)))
export createWithName = (name, url) => (
  {
    url,
    sanitizedUrl: sanitizeUrl(url),
    versionRange: Version.AnyVersion,
    description: Nothing,
    name,
  }
)
export create = createWithName(Nothing)
toJsonName = (dep, base) => where(dep.name) {
  Just(name) =>
    [...base, #["name", P.string(name)]]

  Nothing =>
    base
}
toJsonDesc = (dep, base) => where(dep.description) {
  Just(desc) =>
    [...base, #["description", P.string(desc)]]

  Nothing =>
    base
}
toJsonMin = (dep, base) => where(dep.versionRange) {
  Version.VersionRange(minV, _) =>
    [...base, #["minVersion", P.string(Version.showVersion(minV))]]

  Version.FromVersion(minV) =>
    [...base, #["minVersion", P.string(Version.showVersion(minV))]]

  _ =>
    base
}
toJsonMax = (dep, base) => where(dep.versionRange) {
  Version.VersionRange(_, maxV) =>
    [...base, #["maxVersion", P.string(Version.showVersion(maxV))]]

  Version.UntilVersion(maxV) =>
    [...base, #["maxVersion", P.string(Version.showVersion(maxV))]]

  _ =>
    base
}
serializeDependency :: Dependency -> Value
serializeDependency = (dep) => {
  base = [#["url", P.string(dep.url)]]
  raw = pipe(
    map((fn) => fn(dep)),
    List.reduce((agg, fn) => fn(agg), base),
  )([toJsonName, toJsonDesc, toJsonMin, toJsonMax])

  // withName = toJsonName(dep, base)

  // withDesc = toJsonDesc(dep, withName)

  // withMin = toJsonMin(dep, withDesc)

  // withMax = toJsonMax(dep, withMin)
  // IO.pTrace("rawwwwrere", #[raw, withMax])
  return P.object(raw)
}
