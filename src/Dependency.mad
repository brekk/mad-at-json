import type { Maybe } from "Maybe"

import type { Dependency } from "@/Parse/Dependency"
import type { VersionRange } from "@/Version"

import J from "Json/Parse"
import { Just } from "Maybe"
import { Nothing } from "Maybe"
import {} from "Wish"

import ParseDependency from "@/Parse/Dependency"
import Version from "@/Version"



createWithRangeAndDescription :: Maybe String
  -> String
  -> String
  -> Version
  -> Version
  -> Dependency
export createWithRangeAndDescription = (
  description,
  name,
  url,
  minVer,
  maxVer
) => ParseDependency.construct(url, description, Just(minVer), Just(maxVer), name)
export createWithRange = createWithRangeAndDescription(Nothing)
createWithDescription :: Maybe String -> String -> String -> Version -> Dependency
export createWithDescription = (d, n, u, min) => ParseDependency.construct(
  u,
  d,
  Just(min),
  Nothing,
  n,
)
export create = createWithDescription(Nothing)
printDependency :: Dependency -> String
export printDependency = ({ description, name, url, versionRange }) => `{
  "description": ${description ?? ""},
  "url": ${show(url)},
  "name": ${show(name)},
  ${Version.printRange(versionRange)}
}`
