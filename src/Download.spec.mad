import type { Dependency } from "@model/Dependency"

import { always } from "Function"
import { Nothing } from "Maybe"
import String from "String"
import { ErrorWithMessage, assertEquals, test } from "Test"
import { bad, good, mapRej } from "Wish"

import { downloadIfNotCached } from "@model/Download"
import {
  DownloadError,
  Downloaded,
  FromCache,
  FromRemote,
  formatDownloadFailure,
} from "@model/Download"
import Proxy from "@model/Proxy"
import { sanitizeUrl } from "@model/URL"
import { AnyVersion } from "@model/Version"



dependency :: String -> Dependency
dependency = (url) => (
  {
    description: Nothing,
    url,
    sanitizedUrl: sanitizeUrl(url),
    versionRange: AnyVersion,
    name: Nothing,
  }
)
resultLabel = where {
  Downloaded(_, FromCache) =>
    "cache"

  Downloaded(_, FromRemote) =>
    "remote"

  DownloadError(_, failure) =>
    formatDownloadFailure(failure)
}
localExists = (path) => String.startsWith(".module_cache/", path) ? good(true) : bad({})
fakeProxy = { ...Proxy.fakeProxy, readFile: (_) => good(""), exists: localExists }
test(
  "downloadIfNotCached - valid cache is reused",
  (_) => {
    dep = dependency("http://repo.com/test-package.zip")

    return pipe(
      map(resultLabel),
      mapRej(always(ErrorWithMessage("download failed"))),
      chain(assertEquals($, "cache")),
    )(downloadIfNotCached(fakeProxy, (_, _) => {}, dep))
  },
)
test(
  "downloadIfNotCached - zip with package at archive root is normalized",
  (_) => {
    dep = dependency("http://repo.com/root-package.zip")
    cacheReady = false

    config = {
      ...fakeProxy,
      readFile: (_) => good(""),
      exists: (path) => {
        cacheManifest = `.module_cache/${dep.sanitizedUrl}/madlib.json`
        extractedManifest = `.module_cache/${dep.sanitizedUrl}-tmp/madlib.json`

        return path == cacheManifest
          ? cacheReady ? good(true) : bad({})
          : path == extractedManifest ? good(true) : localExists(path)
      },
      rename: (_, _) => {
        cacheReady := true
        return good({})
      },
    }

    return pipe(
      map(resultLabel),
      mapRej(always(ErrorWithMessage("download failed"))),
      chain(assertEquals($, "remote")),
    )(downloadIfNotCached(config, (_, _) => {}, dep))
  },
)
test(
  "downloadIfNotCached - zip with one top-level package directory is normalized",
  (_) => {
    dep = dependency("http://repo.com/folder-package.zip")
    cacheReady = false

    config = {
      ...fakeProxy,
      readDir: (_) => good(["pkg"]),
      exists: (path) => {
        cacheManifest = `.module_cache/${dep.sanitizedUrl}/madlib.json`
        rootManifest = `.module_cache/${dep.sanitizedUrl}-tmp/madlib.json`
        childManifest = `.module_cache/${dep.sanitizedUrl}-tmp/pkg/madlib.json`

        return path == cacheManifest
          ? cacheReady ? good(true) : bad({})
          : path == rootManifest ? bad({}) : path == childManifest ? good(true) : localExists(path)
      },
      rename: (_, _) => {
        cacheReady := true
        return good({})
      },
    }

    return pipe(
      map(resultLabel),
      mapRej(always(ErrorWithMessage("download failed"))),
      chain(assertEquals($, "remote")),
    )(downloadIfNotCached(config, (_, _) => {}, dep))
  },
)
test(
  "downloadIfNotCached - malformed zip shape returns diagnostic",
  (_) => {
    dep = dependency("http://repo.com/bad-package.zip")

    config = {
      ...fakeProxy,
      readDir: (_) => good(["a", "b"]),
      exists: (path) => {
        cacheManifest = `.module_cache/${dep.sanitizedUrl}/madlib.json`
        rootManifest = `.module_cache/${dep.sanitizedUrl}-tmp/madlib.json`

        return path == cacheManifest || path == rootManifest ? bad({}) : localExists(path)
      },
    }

    return pipe(
      map(resultLabel),
      mapRej(always(ErrorWithMessage("download failed"))),
      chain(
        assertEquals(
          $,
          "invalid archive shape: expected madlib.json at archive root or in a single top-level directory — try deleting .module_cache/ and retrying",
        ),
      ),
    )(downloadIfNotCached(config, (_, _) => {}, dep))
  },
)
