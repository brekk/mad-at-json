import type { Maybe } from "Maybe"

import type { Options, ResolutionOverride } from "./ConflictResolver"

import { always, identity } from "Function"
import IO from "IO"
import List from "List"
import { Just, Nothing } from "Maybe"
import Process from "Process"
import String from "String"
import { fulfill } from "Wish"

import { defaultConfig } from "./Config"
import Graph from "./Graph"
import { run } from "./Run"
import Upgrade from "./Upgrade"
import Version from "./Version"
import Why from "./Why"



type Mode = Install(Options) | ShowGraph | ShowUpgrade | ShowWhy(String) | Invalid(String)
parseResolution :: String -> Maybe ResolutionOverride
parseResolution = (raw) => where(String.split("@", raw)) {
  [name, version] =>
    where(Version.parse(version)) {
      Just(_) =>
        name == "" ? Nothing : Just({ name, version })

      Nothing =>
        Nothing
    }

  _ =>
    Nothing
}
parseInstallOptions :: List String -> Boolean -> List ResolutionOverride -> Mode
parseInstallOptions = (args, interactive, overrides) => where(args) {
  [] =>
    Install({ interactive, overrides })

  ["--interactive", ...rest] =>
    parseInstallOptions(rest, true, overrides)

  ["--resolve", raw, ...rest] =>
    where(parseResolution(raw)) {
      Just(resolution) =>
        parseInstallOptions(rest, interactive, [...overrides, resolution])

      Nothing =>
        Invalid(`Invalid resolution '${raw}'; expected PACKAGE@x.y.z`)
    }

  [arg, ..._] =>
    Invalid(`Unknown install option '${arg}'`)
}
parseMode :: List String -> Mode
parseMode = (args) => where(List.drop(1, args)) {
  ["--graph", ..._] =>
    ShowGraph

  ["--upgrade", ..._] =>
    ShowUpgrade

  ["--why", pkg, ..._] =>
    ShowWhy(pkg)

  remainingArgs =>
    parseInstallOptions(remainingArgs, false, [])
}
main = () => {
  mode = parseMode(Process.Argv)
  config = defaultConfig
  exitWithError = (error) => {
    IO.trace("error", error)
    return Process.exit(1)
  }

  where(mode) {
    ShowGraph =>
      pipe(
        Graph.render,
        fulfill(exitWithError, identity),
      )(config)

    ShowUpgrade =>
      pipe(
        Upgrade.render,
        fulfill(exitWithError, identity),
      )(config)

    Invalid(message) =>
      always(
        do {
          IO.putLine(`error: ${message}`)
          return Process.exit(1)
        },
      )

    ShowWhy(pkg) =>
      fulfill(exitWithError, identity, Why.render(config, pkg))

    Install(options) =>
      pipe(
        run(options),
        fulfill(exitWithError, identity),
      )(config)
  }
}
