import String from "String"
import { assertEquals, test } from "Test"

import { sanitizeUrl } from "@model/URL"



test(
  "sanitizeUrl",
  (_) => assertEquals(String.startsWith("u_", sanitizeUrl("https://url.tld")), true),
)
test(
  "sanitizeUrl - #",
  (_) => assertEquals(String.startsWith("u_", sanitizeUrl("https://url.tld#anchor")), true),
)
test(
  "sanitizeUrl - ? and =",
  (_) => assertEquals(String.startsWith("u_", sanitizeUrl("https://url.tld?param=value")), true),
)
test(
  "sanitizeUrl - -",
  (_) => assertEquals(String.startsWith("u_", sanitizeUrl("https://dom-ain.tld")), true),
)
test(
  "sanitizeUrl - distinct urls do not collide",
  (_) => assertEquals(
    sanitizeUrl("https://dom-ain.tld") == sanitizeUrl("https://dom_ain.tld"),
    false,
  ),
)
