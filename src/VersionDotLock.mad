import type { Wish } from "Wish"

import type { Proxy } from "@model/Proxy"

import { Left, Right } from "Either"
import File from "File"
import { always } from "Function"
import {} from "Json"
import J from "Json/Parse"
import P from "Json/Print"
import { bad, bichain, mapRej } from "Wish"

import { baseProxy } from "@model/Proxy"



export alias PublicAPI = {
  apiAliases :: Dictionary String String,
  apiInstances :: List String,
  apiInterfaces :: Dictionary String (Dictionary String String),
  apiNames :: Dictionary String String,
  apiTypes :: Dictionary String (List String),
}
instance Json PublicAPI {
  fromJson = apiParser

  toJson = ({ apiAliases, apiInstances, apiInterfaces, apiNames, apiTypes }) => P.object([
    #["apiAliases", toJson(apiAliases)],
    #["apiInstances", toJson(apiInstances)],
    #["apiInterfaces", toJson(apiInterfaces)],
    #["apiNames", toJson(apiNames)],
    #["apiTypes", toJson(apiTypes)],
  ])
}
export alias VersionDotLock = {
  buildHash :: String,
  jsApi :: PublicAPI,
  llvmApi :: PublicAPI,
  versionHash :: String,
}
instance Json VersionDotLock {
  fromJson = parser

  toJson = ({ buildHash, jsApi, llvmApi, versionHash }) => P.object([
    #["buildHash", P.string(buildHash)],
    #["jsApi", toJson(jsApi)],
    #["llvmApi", toJson(llvmApi)],
    #["versionHash", P.string(versionHash)],
  ])
}
apiParser :: J.Parser PublicAPI
apiParser = J.map5(
  (apiNames, apiInstances, apiAliases, apiTypes, apiInterfaces) => (
    { apiNames, apiInstances, apiAliases, apiTypes, apiInterfaces }
  ),
  J.field("apiNames", J.dict(J.string)),
  J.field("apiInstances", J.list(J.string)),
  J.field("apiAliases", J.dict(J.string)),
  J.field("apiTypes", J.dict(J.list(J.string))),
  J.field("apiInterfaces", J.dict(J.dict(J.string))),
)
parser :: J.Parser VersionDotLock
parser = J.map4(
  (buildHash, versionHash, jsApi, llvmApi) => ({ buildHash, versionHash, jsApi, llvmApi }),
  J.field("buildHash", J.string),
  J.field("versionHash", J.string),
  J.field("jsApi", apiParser),
  J.field("llvmApi", apiParser),
)
parse :: String -> Wish String VersionDotLock
export parse = pipe(
  J.parse(parser),
  where {
    Left(_) =>
      bad("version.lock file is malformed")

    Right(a) =>
      of(a)
  },
)
loadWithProxy :: Proxy -> String -> Wish String VersionDotLock
export loadWithProxy = (config, path) => pipe(
  config.readFile,
  bichain(
    always(bad(`version.lock file not found at path '${path}'`)),
    pipe(
      parse,
      mapRej(always(`version.lock file at path '${path}' is malformed`)),
    ),
  ),
)(path)
export load = loadWithProxy(baseProxy)
export writeWithWidth = (width, jj) => pipe(
  toJson,
  P.printJson(width),
)(jj)
export write = writeWithWidth(80)
